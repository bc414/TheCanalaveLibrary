<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- bUnit provides the Blazor component hosting/rendering infrastructure for tests. -->
    <PackageReference Include="bunit" Version="2.7.2" />
    <!-- TEST-ONLY security pin for a transitive. bUnit 2.7.2 floors AngleSharp at 1.4.0, which
         carries CVE-2026-54570 (GHSA-pgww-w46g-26qg) and GHSA-cgp3-27rh-pcp2. This pin keeps it on
         the same version the Server pins (security.md pin rules). Move it with the Server's
         AngleSharp reference (WU-DependencyCVEs, 2026-10-12). -->
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Add Client reference here if a tested component lives in TheCanalaveLibrary.Client. -->
    <ProjectReference Include="..\TheCanalaveLibrary.SharedUI\TheCanalaveLibrary.SharedUI.csproj" />
  </ItemGroup>

</Project>
