      SELECT b.blog_post_id AS "BlogPostId", b.author_id AS "AuthorId", a.user_name AS "AuthorDisplayName", b.title AS "Title", b.content AS "Content", p.rating AS "Rating", p.date_created AS "DateCreated", p.last_updated_date AS "LastUpdatedDate", b.like_count AS "LikeCount", p.is_published AS "IsPublished", p.has_spoilers AS "HasSpoilers", p.story_id AS "StoryId", s1.story_title AS "LinkedStoryTitle", NULL AS "GroupId", NULL AS "GroupAudience", EXISTS (&#xD;
