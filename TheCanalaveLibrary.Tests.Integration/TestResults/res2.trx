                  WHERE s8.id = u0.user_id AND u0.external_platform_id = s7.external_platform_id AND u0.verification_status = 1&#xD;
                  LIMIT 1)&#xD;
          END AS c1, s7.story_external_link_id, e.external_platform_id, s7.external_platform_id AS external_platform_id0&#xD;
          FROM story_external_links AS s7&#xD;
