      Executed DbCommand (1ms) [Parameters=[@chapterId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT c.story_id AS "StoryId", c.is_published AS "IsPublished"&#xD;
