      SELECT s.story_id, CASE&#xD;
          WHEN s0.story_id IS NOT NULL THEN s0.story_title&#xD;
          ELSE ''&#xD;
      END, s0.short_description, s0.cover_art_relative_url, s.author_id, a.user_name, s.word_count, s.story_status_id, s.rating, s.last_updated_date, s0.story_id, a.id, s2.tag_id, s2.tag_name, s2.tag_type_id, s2.description, s2.sprite_identifier, s2.story_id, s2.tag_id0&#xD;
