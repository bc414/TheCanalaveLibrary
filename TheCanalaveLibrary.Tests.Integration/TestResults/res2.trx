      Executed DbCommand (3ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @ef_filter__UserId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s.story_external_link_id, s.story_id, CASE&#xD;
          WHEN s2.story_id IS NOT NULL THEN s2.story_title&#xD;
          ELSE ''&#xD;
      END, '/story/' || s.story_id::text, s.external_platform_id, e.name, s.url, s1.author_id, COALESCE(a.user_name, ''), (&#xD;
          SELECT u0.handle&#xD;
          FROM user_external_identities AS u0&#xD;
          WHERE a.id IS NOT NULL AND a.id = u0.user_id AND u0.external_platform_id = s.external_platform_id AND u0.verification_status = 1&#xD;
          LIMIT 1), (&#xD;
          SELECT u1.profile_url&#xD;
          FROM user_external_identities AS u1&#xD;
          WHERE a.id IS NOT NULL AND a.id = u1.user_id AND u1.external_platform_id = s.external_platform_id AND u1.verification_status = 1&#xD;
          LIMIT 1), s.date_verification_requested&#xD;
      FROM story_external_links AS s&#xD;
      INNER JOIN (&#xD;
          SELECT s0.story_id, s0.author_id&#xD;
          FROM stories AS s0&#xD;
          WHERE s0.rating &lt;= @ef_filter__p AND (s0.story_status_id NOT IN (0, 1, 8) OR (s0.author_id IS NOT NULL AND s0.author_id = @ef_filter__UserId)) AND NOT (s0.is_taken_down)&#xD;
      ) AS s1 ON s.story_id = s1.story_id&#xD;
      LEFT JOIN "AspNetUsers" AS a ON s1.author_id = a.id&#xD;
      LEFT JOIN story_listings AS s2 ON s1.story_id = s2.story_id&#xD;
      INNER JOIN external_platforms AS e ON s.external_platform_id = e.external_platform_id&#xD;
      WHERE s.verification_status = 0 AND s.date_verification_requested IS NOT NULL AND a.id IS NOT NULL AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM user_external_identities AS u&#xD;
          WHERE a.id = u.user_id AND u.external_platform_id = s.external_platform_id AND u.verification_status = 1)&#xD;
      ORDER BY s.date_verification_requested&#xD;
