      UPDATE user_stats us&#xD;
SET stories_ignored = 0&#xD;
WHERE us.stories_ignored &lt;&gt; 0&#xD;
  AND NOT EXISTS (SELECT 1 FROM (SELECT user_id, COUNT(*)::integer AS value FROM user_story_interactions WHERE is_ignored GROUP BY user_id) agg WHERE agg.user_id = us.user_id)&#xD;
