info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@seriesId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s1.series_id, s1.name, s1.description, s1.author_id, s1.user_name, s1.date_created, s1.id, s0.story_id, s0.series_id&#xD;
      FROM (&#xD;
          SELECT s.series_id, s.name, s.description, s.author_id, a.user_name, s.date_created, a.id&#xD;
          FROM series AS s&#xD;
          LEFT JOIN "AspNetUsers" AS a ON s.author_id = a.id&#xD;
          WHERE s.series_id = @seriesId&#xD;
          LIMIT 1&#xD;
      ) AS s1&#xD;
      LEFT JOIN series_entries AS s0 ON s1.series_id = s0.series_id&#xD;
      ORDER BY s1.series_id, s1.id, s0.order_index, s0.series_id&#xD;
