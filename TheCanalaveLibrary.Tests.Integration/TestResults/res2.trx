          FROM private_messages AS p2&#xD;
          WHERE c0.conversation_id = p2.conversation_id AND (p2.sender_user_id &lt;&gt; @viewerId2 OR p2.sender_user_id IS NULL) AND (c.last_read_timestamp IS NULL OR p2.date_sent &gt; c.last_read_timestamp)), s0."UserId", s0."Username", s0."AvatarUrl", s0.c, p4."MessageText", p4."DateSent", p4.c&#xD;
