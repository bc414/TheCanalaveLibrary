info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT c.spotlight_id, c.story_id, c.recommendation_id, c.start_date, c.end_date&#xD;
      FROM community_spotlights AS c&#xD;
      INNER JOIN (&#xD;
          SELECT s.story_id&#xD;
          FROM stories AS s&#xD;
          WHERE s.rating &lt;= @ef_filter__p AND s.story_status_id NOT IN (0, 1, 8) AND NOT (s.is_taken_down)&#xD;
      ) AS s0 ON c.story_id = s0.story_id&#xD;
      WHERE c.start_date &lt;= @now AND @now &lt; c.end_date&#xD;
      ORDER BY c.start_date, c.spotlight_id&#xD;
