      LEFT JOIN story_listings AS s0 ON s.story_id = s0.story_id&#xD;
      LEFT JOIN "AspNetUsers" AS a ON s.author_id = a.id&#xD;
      LEFT JOIN (&#xD;
          SELECT s1.tag_id, t.tag_name, t.tag_type_id, t.description, t.sprite_identifier, s1.story_id, t.tag_id AS tag_id0&#xD;
          FROM story_tags AS s1&#xD;
          INNER JOIN tags AS t ON s1.tag_id = t.tag_id&#xD;
      ) AS s2 ON s.story_id = s2.story_id&#xD;
