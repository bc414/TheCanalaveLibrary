      SELECT s8.story_id, s8.c, s8.c0, s8.c1, s8.word_count, s8.published_date, s8.last_updated_date, s8.original_published_date, s8.original_last_updated_date, s8.author_id, s8.user_name, s8.cover_art_relative_url, s8.rating, s8.story_status_id, s8.slug, s8.story_id0, s8.story_id1, s8.id, s9.tag_id, s9.tag_name, s9.tag_type_id, s9.description, s9.sprite_identifier, s9.story_id, s9.tag_id0, s10.character_tag_id, s10.tag_name, s10.sprite_identifier, s10.priority, s10.is_oc, s10.oc_name, s10.oc_bio, s10.story_character_id, s10.tag_id, s12.pairing_type, s12.priority, s12.story_character_pairing_id, s12.tag_name, s12.story_character_pairing_id0, s12.story_character_id, s12.story_character_id0, s12.tag_id, s13.name, s13.url, s13.c, s13.c0, s13.c1, s13.story_external_link_id, s13.external_platform_id&#xD;
      FROM (&#xD;
          SELECT s.story_id, CASE&#xD;
              WHEN s0.story_id IS NOT NULL THEN s0.story_title&#xD;
              ELSE ''&#xD;
          END AS c, CASE&#xD;
              WHEN s0.story_id IS NOT NULL THEN COALESCE(s0.short_description, '')&#xD;
              ELSE ''&#xD;
          END AS c0, CASE&#xD;
              WHEN s1.story_id IS NOT NULL THEN COALESCE(s1.long_description, '')&#xD;
              ELSE ''&#xD;
          END AS c1, s.word_count, s.published_date, s.last_updated_date, s.original_published_date, s.original_last_updated_date, s.author_id, a.user_name, s0.cover_art_relative_url, s.rating, s.story_status_id, s1.slug, s0.story_id AS story_id0, s1.story_id AS story_id1, a.id&#xD;
          FROM stories AS s&#xD;
          LEFT JOIN story_listings AS s0 ON s.story_id = s0.story_id&#xD;
          LEFT JOIN story_details AS s1 ON s.story_id = s1.story_id&#xD;
          LEFT JOIN "AspNetUsers" AS a ON s.author_id = a.id&#xD;
          WHERE s.rating &lt;= @ef_filter__p AND s.story_status_id NOT IN (0, 1, 8) AND NOT (s.is_taken_down) AND s.story_id = @storyId&#xD;
          LIMIT 1&#xD;
      ) AS s8&#xD;
      LEFT JOIN (&#xD;
          SELECT s2.tag_id, t.tag_name, t.tag_type_id, t.description, t.sprite_identifier, s2.story_id, t.tag_id AS tag_id0&#xD;
          FROM story_tags AS s2&#xD;
          INNER JOIN tags AS t ON s2.tag_id = t.tag_id&#xD;
      ) AS s9 ON s8.story_id = s9.story_id&#xD;
      LEFT JOIN (&#xD;
          SELECT s3.character_tag_id, t0.tag_name, t0.sprite_identifier, s3.priority, s3.is_oc, s3.oc_name, s3.oc_bio, s3.story_character_id, t0.tag_id, s3.story_id&#xD;
          FROM story_characters AS s3&#xD;
          INNER JOIN tags AS t0 ON s3.character_tag_id = t0.tag_id&#xD;
      ) AS s10 ON s8.story_id = s10.story_id&#xD;
      LEFT JOIN (&#xD;
          SELECT s4.pairing_type, s4.priority, s4.story_character_pairing_id, s11.tag_name, s11.story_character_pairing_id AS story_character_pairing_id0, s11.story_character_id, s11.story_character_id0, s11.tag_id, s4.story_id&#xD;
          FROM story_character_pairings AS s4&#xD;
          LEFT JOIN (&#xD;
              SELECT t1.tag_name, s5.story_character_pairing_id, s5.story_character_id, s6.story_character_id AS story_character_id0, t1.tag_id&#xD;
              FROM story_character_pairing_members AS s5&#xD;
              INNER JOIN story_characters AS s6 ON s5.story_character_id = s6.story_character_id&#xD;
              INNER JOIN tags AS t1 ON s6.character_tag_id = t1.tag_id&#xD;
