WHERE us.stories_in_progress &lt;&gt; 0&#xD;
  AND NOT EXISTS (SELECT 1 FROM (SELECT user_id, COUNT(*)::integer AS value FROM user_story_interactions WHERE has_started AND NOT is_completed GROUP BY user_id) agg WHERE agg.user_id = us.user_id)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
