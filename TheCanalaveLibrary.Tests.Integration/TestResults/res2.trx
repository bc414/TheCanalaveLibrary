      BEGIN;&#xD;
DROP TABLE IF EXISTS user_story_tree_search_entries;&#xD;
ALTER TABLE user_story_tree_search_entries_staging RENAME TO user_story_tree_search_entries;&#xD;
ALTER TABLE user_story_tree_search_entries RENAME CONSTRAINT pk_user_story_tree_search_entries_staging TO pk_user_story_tree_search_entries;&#xD;
ALTER INDEX ix_tree_search_user_edge_staging RENAME TO ix_tree_search_user_edge;&#xD;
ALTER INDEX ix_tree_search_story_edge_staging RENAME TO ix_tree_search_story_edge;&#xD;
COMMIT;&#xD;
