      Executed DbCommand (1ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @ef_filter__UserId='?' (DbType = Int32), @seriesId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s.story_id AS "StoryId", CASE&#xD;
          WHEN s2.story_id IS NOT NULL THEN s2.story_title&#xD;
          ELSE ''&#xD;
      END AS "Title"&#xD;
      FROM series_entries AS s&#xD;
      INNER JOIN (&#xD;
          SELECT s0.story_id&#xD;
          FROM stories AS s0&#xD;
          WHERE s0.rating &lt;= @ef_filter__p AND (s0.story_status_id NOT IN (0, 1, 8) OR (s0.author_id IS NOT NULL AND s0.author_id = @ef_filter__UserId)) AND NOT (s0.is_taken_down)&#xD;
      ) AS s1 ON s.story_id = s1.story_id&#xD;
      LEFT JOIN story_listings AS s2 ON s1.story_id = s2.story_id&#xD;
      WHERE s.series_id = @seriesId&#xD;
      ORDER BY s.order_index&#xD;
