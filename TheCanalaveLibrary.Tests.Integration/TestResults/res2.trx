      SELECT n.notification_id AS "NotificationId", n.notification_type_id AS "NotificationTypeId", n0.notification_category AS "CategoryId", n.source_user_id AS "SourceUserId", a.user_name AS "SourceUserName", n.related_entity_id AS "RelatedEntityId", n.is_read AS "IsRead", n.date_created AS "DateCreated", CASE&#xD;
          WHEN u0.user_id IS NOT NULL AND u0.notification_type_id IS NOT NULL THEN u0.collapsed&#xD;
          ELSE n0.default_collapsed&#xD;
      END AS "Collapsed"&#xD;
      FROM notifications AS n&#xD;
      INNER JOIN notification_types AS n0 ON n.notification_type_id = n0.notification_type_id&#xD;
      LEFT JOIN (&#xD;
          SELECT u.user_id, u.notification_type_id, u.collapsed&#xD;
          FROM user_notification_settings AS u&#xD;
          WHERE u.user_id = @userId&#xD;
      ) AS u0 ON n.notification_type_id = u0.notification_type_id&#xD;
      LEFT JOIN "AspNetUsers" AS a ON n.source_user_id = a.id&#xD;
      WHERE n.recipient_user_id = @userId&#xD;
      ORDER BY n.date_created DESC, n.notification_id DESC&#xD;
      LIMIT @p3 OFFSET @p&#xD;
