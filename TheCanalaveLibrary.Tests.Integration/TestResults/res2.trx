      SELECT s.story_id, s0.story_title, COALESCE(a.user_name, '[deleted]'), s.rating, s.published_date, s1.post_approval_status, EXISTS (&#xD;
          SELECT 1&#xD;
          FROM story_external_links AS s2&#xD;
          WHERE s2.story_id = s.story_id)&#xD;
      FROM stories AS s&#xD;
      INNER JOIN story_listings AS s0 ON s.story_id = s0.story_id&#xD;
