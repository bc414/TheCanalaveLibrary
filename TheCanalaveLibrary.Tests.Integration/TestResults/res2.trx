      Executed DbCommand (1ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @_8__locals1_storyIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s.story_id, CASE&#xD;
          WHEN s0.story_id IS NOT NULL THEN s0.story_title&#xD;
          ELSE ''&#xD;
      END, s0.short_description, s0.cover_art_relative_url, s.author_id, a.user_name, s.word_count, s.story_status_id, s.rating, s.last_updated_date, s0.story_id, a.id, s2.tag_id, s2.tag_name, s2.tag_type_id, s2.description, s2.sprite_identifier, s2.story_id, s2.tag_id0&#xD;
      FROM stories AS s&#xD;
      LEFT JOIN story_listings AS s0 ON s.story_id = s0.story_id&#xD;
      LEFT JOIN "AspNetUsers" AS a ON s.author_id = a.id&#xD;
      LEFT JOIN (&#xD;
          SELECT s1.tag_id, t.tag_name, t.tag_type_id, t.description, t.sprite_identifier, s1.story_id, t.tag_id AS tag_id0&#xD;
          FROM story_tags AS s1&#xD;
          INNER JOIN tags AS t ON s1.tag_id = t.tag_id&#xD;
      ) AS s2 ON s.story_id = s2.story_id&#xD;
      WHERE s.rating &lt;= @ef_filter__p AND s.story_status_id NOT IN (0, 1, 8) AND NOT (s.is_taken_down) AND s.story_id = ANY (@_8__locals1_storyIds)&#xD;
      ORDER BY s.story_id, s0.story_id, a.id, s2.story_id, s2.tag_id&#xD;
