      SELECT r1.recommendation_id, r1.active_report_count, r1.date_posted, r1.is_hidden_gem, r1.is_highlighted_by_author, r1.is_taken_down, r1.like_count, r1.recommender_id, r1.revision_request_note, r1.status_id, r1.story_id, r1.successful_rec_count, r1.takedown_date, r1.takedown_reason, r2.user_id, r2.recommendation_id&#xD;
      FROM (&#xD;
          SELECT r.recommendation_id, r.active_report_count, r.date_posted, r.is_hidden_gem, r.is_highlighted_by_author, r.is_taken_down, r.like_count, r.recommender_id, r.revision_request_note, r.status_id, r.story_id, r.successful_rec_count, r.takedown_date, r.takedown_reason&#xD;
          FROM recommendations AS r&#xD;
          WHERE r.recommendation_id = @recommendationId&#xD;
          LIMIT 1&#xD;
