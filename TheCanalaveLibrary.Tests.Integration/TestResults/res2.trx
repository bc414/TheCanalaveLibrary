      UPDATE user_stats us&#xD;
SET stories_written = agg.value&#xD;
FROM (SELECT author_id AS user_id, COUNT(*)::integer AS value FROM stories WHERE author_id IS NOT NULL GROUP BY author_id) agg&#xD;
WHERE us.user_id = agg.user_id&#xD;
  AND us.stories_written IS DISTINCT FROM agg.value&#xD;
