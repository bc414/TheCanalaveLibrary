      LIMIT 1&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@id='?' (DbType = Int64)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT b.comment_id, b.active_report_count, b.comment_text, b.is_taken_down, b.like_count, b.parent_comment_id, b.takedown_date, b.takedown_reason, b.user_id, c.chapter_id, c.date_posted, c.is_spoiler&#xD;
      FROM base_comments AS b&#xD;
      INNER JOIN chapter_comments AS c ON b.comment_id = c.comment_id&#xD;
      WHERE b.comment_id = @id&#xD;
      LIMIT 1&#xD;
