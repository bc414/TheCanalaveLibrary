      INSERT INTO user_story_interactions (story_id, user_id, has_started, is_completed, is_favorite, is_followed, is_hidden_favorite, is_ignored, is_read_it_later, recommendation_id)&#xD;
      VALUES (@p0, @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9);&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @_8__locals1_request_StoryId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s0.id, s0.user_name, s0.tagline, s0.c, s0.story_id, s1.icon_base_url, s1.display_name, s1.user_id, s1.badge_key, s1.badge_key0&#xD;
      FROM (&#xD;
          SELECT a.id, a.user_name, a.tagline, COALESCE(a.profile_picture_relative_url, '/img/default-avatar.svg') AS c, s.story_id&#xD;
          FROM stories AS s&#xD;
          LEFT JOIN "AspNetUsers" AS a ON s.author_id = a.id&#xD;
          WHERE s.rating &lt;= @ef_filter__p AND s.story_status_id NOT IN (0, 1, 8) AND NOT (s.is_taken_down) AND s.story_id = @_8__locals1_request_StoryId AND a.id IS NOT NULL&#xD;
          LIMIT 1&#xD;
      ) AS s0&#xD;
      LEFT JOIN (&#xD;
          SELECT b.icon_base_url, b.display_name, u.user_id, u.badge_key, b.badge_key AS badge_key0, u.display_order&#xD;
          FROM user_badges AS u&#xD;
          INNER JOIN badges AS b ON u.badge_key = b.badge_key&#xD;
          WHERE u.display_order &gt; 0&#xD;
      ) AS s1 ON s0.id = s1.user_id&#xD;
      ORDER BY s0.story_id, s0.id, s1.display_order, s1.user_id, s1.badge_key&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@ef_filter__p='?' (DbType = Int16), @_8__locals1_request_StoryId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT count(*)::int&#xD;
      FROM recommendations AS r&#xD;
      WHERE NOT (r.is_taken_down) AND r.status_id = 2 AND r.recommender_id IS NOT NULL AND EXISTS (&#xD;
