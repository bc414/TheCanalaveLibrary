      SELECT EXISTS (&#xD;
          SELECT 1&#xD;
          FROM stories AS s&#xD;
          WHERE s.rating &lt;= @ef_filter__p AND (s.story_status_id NOT IN (0, 1, 8) OR (s.author_id IS NOT NULL AND s.author_id = @ef_filter__UserId)) AND NOT (s.is_taken_down) AND s.story_id = @storyId)&#xD;
