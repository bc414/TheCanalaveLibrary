          WHERE s0.story_id IS NOT NULL AND s0.story_id = c2.story_id AND c2.is_published AND c2.chapter_number &lt; c1.chapter_number&#xD;
          ORDER BY c2.chapter_number DESC&#xD;
          LIMIT 1), (&#xD;
          SELECT c3.chapter_number&#xD;
