      CREATE INDEX ix_tree_search_user_edge_staging&#xD;
    ON user_story_tree_search_entries_staging (user_id, edge_type) INCLUDE (story_id);&#xD;
CREATE INDEX ix_tree_search_story_edge_staging&#xD;
    ON user_story_tree_search_entries_staging (story_id, edge_type) INCLUDE (user_id);&#xD;
