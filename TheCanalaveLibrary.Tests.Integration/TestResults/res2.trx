      SELECT b.poll_id, b.poll_name, b.description, b.date_opened, b.date_closed, b.allow_multiple, b.results_visibility, b.anonymity_mode, b.owner_id, a.user_name, s.poll_id IS NOT NULL AND s.is_archived, CASE&#xD;
          WHEN b0.poll_id IS NOT NULL THEN b0.blog_post_id&#xD;
      END, (&#xD;
          SELECT count(*)::int&#xD;
          FROM (&#xD;
              SELECT DISTINCT p0.user_id&#xD;
              FROM poll_options AS p&#xD;
              INNER JOIN poll_votes AS p0 ON p.poll_option_id = p0.poll_option_id&#xD;
              WHERE b.poll_id = p.poll_id&#xD;
          ) AS s0), a.id, s1.poll_option_id, s1.poll_option_id0, s1.user_id, EXISTS (&#xD;
          SELECT 1&#xD;
          FROM poll_options AS p3&#xD;
          INNER JOIN poll_votes AS p4 ON p3.poll_option_id = p4.poll_option_id&#xD;
          WHERE b.poll_id = p3.poll_id AND p4.user_id = @viewerId AND p4.is_anonymous), s3.poll_option_id, s3.text, s3.sort_order, s3.c, s3."UserId", s3."UserName", s3.poll_option_id0, s3.id&#xD;
      FROM base_polls AS b&#xD;
      LEFT JOIN blog_post_polls AS b0 ON b.poll_id = b0.poll_id&#xD;
      LEFT JOIN site_polls AS s ON b.poll_id = s.poll_id&#xD;
      INNER JOIN "AspNetUsers" AS a ON b.owner_id = a.id&#xD;
      LEFT JOIN (&#xD;
          SELECT p2.poll_option_id, p1.poll_option_id AS poll_option_id0, p2.user_id, p1.poll_id&#xD;
          FROM poll_options AS p1&#xD;
          INNER JOIN poll_votes AS p2 ON p1.poll_option_id = p2.poll_option_id&#xD;
          WHERE p2.user_id = @viewerId&#xD;
      ) AS s1 ON b.poll_id = s1.poll_id&#xD;
      LEFT JOIN (&#xD;
          SELECT p5.poll_option_id, p5.text, p5.sort_order, (&#xD;
              SELECT count(*)::int&#xD;
              FROM poll_votes AS p6&#xD;
              WHERE p5.poll_option_id = p6.poll_option_id) AS c, s2."UserId", s2."UserName", s2.poll_option_id AS poll_option_id0, s2.id, p5.poll_id&#xD;
          FROM poll_options AS p5&#xD;
          LEFT JOIN (&#xD;
              SELECT p7.user_id AS "UserId", a0.user_name AS "UserName", p7.poll_option_id, a0.id&#xD;
              FROM poll_votes AS p7&#xD;
              INNER JOIN "AspNetUsers" AS a0 ON p7.user_id = a0.id&#xD;
              WHERE NOT (p7.is_anonymous)&#xD;
          ) AS s2 ON p5.poll_option_id = s2.poll_option_id&#xD;
      ) AS s3 ON b.poll_id = s3.poll_id&#xD;
      WHERE b.poll_id = @pollId&#xD;
      ORDER BY b.poll_id, a.id, s1.poll_option_id0, s1.poll_option_id, s1.user_id, s3.sort_order, s3.poll_option_id, s3."UserName", s3.poll_option_id0, s3."UserId"&#xD;
