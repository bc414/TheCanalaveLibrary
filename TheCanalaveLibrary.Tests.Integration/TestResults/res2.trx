      SELECT c0.chapter_id, c1.story_id, c1.chapter_number, c1.title, c0.chapter_text, c0.top_authors_note, c0.bottom_authors_note, c0.word_count, COALESCE(c0.rating, s0.rating), c0.author_id, CASE&#xD;
