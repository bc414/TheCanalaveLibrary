      SELECT u.user_id, u.chapter_id, u.is_read, u.last_interaction_date, u.read_progress&#xD;
      FROM user_chapter_interactions AS u&#xD;
      WHERE u.user_id = @userId AND u.chapter_id = @chapterId&#xD;
      LIMIT 1&#xD;
