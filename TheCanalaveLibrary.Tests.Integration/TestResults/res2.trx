          WHERE c0.conversation_id = p2.conversation_id AND (p2.sender_user_id &lt;&gt; @viewerId2 OR p2.sender_user_id IS NULL) AND (c.last_read_timestamp IS NULL OR p2.date_sent &gt; c.last_read_timestamp)), s0."UserId", s0."Username", s0."AvatarUrl", s0.c, p4."MessageText", p4."DateSent", p4.c&#xD;
      FROM conversation_participants AS c&#xD;
      INNER JOIN conversations AS c0 ON c.conversation_id = c0.conversation_id&#xD;
      LEFT JOIN (&#xD;
          SELECT s."UserId", s."Username", s."AvatarUrl", s.c, s.conversation_id&#xD;
          FROM (&#xD;
              SELECT c1.user_id AS "UserId", a.user_name AS "Username", a.profile_picture_relative_url AS "AvatarUrl", 1 AS c, c1.conversation_id, ROW_NUMBER() OVER(PARTITION BY c1.conversation_id ORDER BY c1.conversation_id, c1.user_id, a.id) AS row&#xD;
              FROM conversation_participants AS c1&#xD;
