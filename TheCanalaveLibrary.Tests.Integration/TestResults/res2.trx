      ) AS s12 ON s8.story_id = s12.story_id&#xD;
      LEFT JOIN LATERAL (&#xD;
          SELECT e.name, s7.url, s7.verification_status = 1 AS c, CASE&#xD;
              WHEN s7.verification_status = 1 AND s8.id IS NOT NULL THEN (&#xD;
                  SELECT u.handle&#xD;
                  FROM user_external_identities AS u&#xD;
                  WHERE s8.id = u.user_id AND u.external_platform_id = s7.external_platform_id AND u.verification_status = 1&#xD;
                  LIMIT 1)&#xD;
          END AS c0, CASE&#xD;
              WHEN s7.verification_status = 1 AND s8.id IS NOT NULL THEN (&#xD;
