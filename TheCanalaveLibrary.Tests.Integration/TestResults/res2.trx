      SELECT s.stat_date, s.active_users, s.chapters_read, s.favorites_added, s.new_blog_posts, s.new_chapters, s.new_comments, s.new_follows, s.new_groups, s.new_recommendation_successes, s.new_recommendations_written, s.new_stories, s.new_users, s.new_words, s.reports_filed, s.reports_resolved, s.story_views, s.total_stories, s.total_users, s.total_words&#xD;
      FROM site_daily_stats AS s&#xD;
