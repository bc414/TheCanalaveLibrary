      SELECT s0.poll_id, s0.allow_multiple, s0.anonymity_mode, s0.date_closed, s0.date_opened, s0.description, s0.edit_notified_at, s0.last_edited_at, s0.owner_id, s0.poll_name, s0.results_visibility, s0.blog_post_id, s0.is_archived, s0."Discriminator", p.poll_option_id, p.poll_id, p.sort_order, p.text&#xD;
      FROM (&#xD;
          SELECT b.poll_id, b.allow_multiple, b.anonymity_mode, b.date_closed, b.date_opened, b.description, b.edit_notified_at, b.last_edited_at, b.owner_id, b.poll_name, b.results_visibility, b0.blog_post_id, s.is_archived, CASE&#xD;
