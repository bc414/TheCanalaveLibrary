      CREATE TABLE IF NOT EXISTS user_story_tree_search_entries (&#xD;
    user_id   integer  NOT NULL,&#xD;
    story_id  integer  NOT NULL,&#xD;
    edge_type smallint NOT NULL,&#xD;
    CONSTRAINT pk_user_story_tree_search_entries PRIMARY KEY (user_id, story_id, edge_type));&#xD;
CREATE INDEX IF NOT EXISTS ix_tree_search_user_edge&#xD;
    ON user_story_tree_search_entries (user_id, edge_type) INCLUDE (story_id);&#xD;
CREATE INDEX IF NOT EXISTS ix_tree_search_story_edge&#xD;
    ON user_story_tree_search_entries (story_id, edge_type) INCLUDE (user_id);&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[], CommandType='Text', CommandTimeout='600']&#xD;
      DROP TABLE IF EXISTS user_story_tree_search_entries_staging;&#xD;
CREATE TABLE user_story_tree_search_entries_staging (&#xD;
    user_id   integer  NOT NULL,&#xD;
    story_id  integer  NOT NULL,&#xD;
    edge_type smallint NOT NULL,&#xD;
    CONSTRAINT pk_user_story_tree_search_entries_staging PRIMARY KEY (user_id, story_id, edge_type));&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[], CommandType='Text', CommandTimeout='600']&#xD;
      INSERT INTO user_story_tree_search_entries_staging (user_id, story_id, edge_type)&#xD;
-- 0 AuthoredBy&#xD;
SELECT s.author_id, s.story_id, 0::smallint&#xD;
FROM stories s&#xD;
WHERE s.author_id IS NOT NULL AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
UNION ALL&#xD;
-- 1 Favorite: public favorites + edge-owner-consented hidden favorites (no separate flag)&#xD;
SELECT usi.user_id, usi.story_id, 1::smallint&#xD;
FROM user_story_interactions usi&#xD;
JOIN stories s ON s.story_id = usi.story_id AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
JOIN "AspNetUsers" u ON u.id = usi.user_id&#xD;
WHERE usi.is_favorite = true&#xD;
   OR (usi.is_hidden_favorite = true AND u.allow_discovery_from_hidden_favorites = true)&#xD;
UNION ALL&#xD;
-- 2 Recommendation&#xD;
SELECT r.recommender_id, r.story_id, 2::smallint&#xD;
FROM recommendations r&#xD;
JOIN stories s ON s.story_id = r.story_id AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
WHERE r.is_taken_down = false AND r.status_id = 2 AND r.recommender_id IS NOT NULL&#xD;
UNION ALL&#xD;
-- 3 Vouch projection: voucher \u001a each published story authored by the vouchee&#xD;
SELECT v.vouching_user_id, s.story_id, 3::smallint&#xD;
FROM vouches v&#xD;
JOIN stories s ON s.author_id = v.vouched_user_id AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
UNION ALL&#xD;
-- 4 HiddenGem (�5/user, service-enforced at write time)&#xD;
SELECT r.recommender_id, r.story_id, 4::smallint&#xD;
FROM recommendations r&#xD;
JOIN stories s ON s.story_id = r.story_id AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
WHERE r.is_taken_down = false AND r.status_id = 2 AND r.recommender_id IS NOT NULL AND r.is_hidden_gem = true&#xD;
UNION ALL&#xD;
-- 5 AuthorSpotlight (�5/story; lands on the (recommender, story) pair)&#xD;
SELECT r.recommender_id, r.story_id, 5::smallint&#xD;
FROM recommendations r&#xD;
JOIN stories s ON s.story_id = r.story_id AND s.is_taken_down = false AND s.story_status_id BETWEEN 2 AND 7&#xD;
WHERE r.is_taken_down = false AND r.status_id = 2 AND r.recommender_id IS NOT NULL AND r.is_highlighted_by_author = true;&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
