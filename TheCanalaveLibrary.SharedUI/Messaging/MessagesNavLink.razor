@namespace TheCanalaveLibrary.SharedUI
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMessagingReadService ReadService
@inject NavigationManager Nav
@inject PersistentComponentState ApplicationState
@inject ILogger<MessagesNavLink> Logger

@* Layout chrome — unread badge beside LoginDisplay. Refreshes on every navigation via
   LocationChanged subscription. Only visible to authenticated users (AuthorizeView).

   Persistence uses the MANUAL PersistentComponentState API, deliberately NOT [PersistentState]
   (see layer5-wasm.md "Components that ALSO render on static-SSR pages"). MainLayout is the
   AuthorizeRouteView DefaultLayout, so this component also renders on the static-SSR Identity
   pages, where App.razor's AcceptsInteractiveRouting() yields no render mode — a
   [PersistentState] property then registers a persistence callback the framework cannot infer a
   render mode for, and ComponentStatePersistenceManager.InferRenderModes throws, 500ing the page.
   Note the AuthorizeView below wraps only the MARKUP: this component is instantiated for every
   viewer, so the attribute form broke /Account/* for anonymous visitors too (H10, broken
   2026-07-13 → 2026-07-31). The RegisterOnPersisting overload takes an EXPLICIT render mode,
   which is the framework's sanctioned escape hatch for components that render in both static and
   interactive trees — the same treatment ReaderDisplayProvider carries, and the one documented
   exception to "don't hand-roll the register/dispose dance." *@

<AuthorizeView>
    <Authorized>
        <a href="/messages"
           class="relative flex items-center gap-1.5 rounded-md px-2 py-1 text-sm text-(--color-text) transition-colors hover:bg-(--color-surface-hover) hover:text-(--color-action-ink)"
           aria-label="@(UnreadCount > 0 ? $"Messages — {UnreadCount} unread" : "Messages")">
            <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span class="hidden sm:inline">Messages</span>
            @if (UnreadCount > 0)
            {
                <span class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-(--color-action) px-1 text-[10px] font-bold leading-none text-(--color-text)"
                      aria-hidden="true">
                    @(UnreadCount > 99 ? "99+" : UnreadCount.ToString())
                </span>
            }
        </a>
    </Authorized>
</AuthorizeView>

@code {
    private const string PersistKey = "messages-unread";

    /// <summary>Persisted across the prerender→interactive handoff (manual API — see header) so
    /// the badge hydrates without a refetch/flash. LocationChanged refreshes stay plain
    /// assignments (internal SPA navs never see persisted state anyway).</summary>
    public int? UnreadCount { get; set; }

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChangedAsync;

        // Register first (the explicit render mode is what makes this legal on static-SSR
        // renders too); restore-or-fetch below. Disposal ends the subscription.
        _persistSub = ApplicationState.RegisterOnPersisting(PersistCountAsync, RenderMode.InteractiveAuto);

        // Restore-or-fetch: skip the initial count query when the prerendered value was restored.
        if (ApplicationState.TryTakeFromJson(PersistKey, out int? restored) && restored is not null)
        {
            UnreadCount = restored;
            return;
        }

        await RefreshCountAsync();
    }

    private Task PersistCountAsync()
    {
        if (UnreadCount is not null)
        {
            ApplicationState.PersistAsJson(PersistKey, UnreadCount);
        }
        return Task.CompletedTask;
    }

    // async void is the correct pattern for Blazor Server event handlers;
    // InvokeAsync marshals the re-render back to the sync context.
    private async void OnLocationChangedAsync(object? sender, LocationChangedEventArgs e)
    {
        await RefreshCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task RefreshCountAsync()
    {
        // Anonymous viewers render nothing (AuthorizeView) — skip the query outright instead of
        // relying on the service throwing, so the catch below only sees genuine failures.
        if (AuthState is not null)
        {
            AuthenticationState auth = await AuthState;
            if (auth.User.Identity?.IsAuthenticated != true)
            {
                UnreadCount = 0;
                return;
            }
        }

        try
        {
            UnreadCount = await ReadService.GetUnreadConversationCountAsync();
        }
        catch (Exception ex)
        {
            // Degraded but continuing — badge shows 0; a real query bug must leave a trace
            // (logging.md §"No silent catches").
            Logger.LogWarning(ex, "Unread-conversation count refresh failed — badge shows 0");
            UnreadCount = 0;
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChangedAsync;
        _persistSub.Dispose();
    }
}
