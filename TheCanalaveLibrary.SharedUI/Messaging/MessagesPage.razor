@page "/messages/{ConversationId:int?}"
@namespace TheCanalaveLibrary.SharedUI
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject IMessagingWriteService WriteService
@inject NavigationManager Nav

@* Page for private messaging (Feature 49).
   Holds all state + handles all mutations. Renders the MessagesDesktop two-pane layout
   (mobile single-pane variant deleted 2026-07-18, WU-ResponsiveMerge — single responsive tree).

   _allMessages is stored newest-first so that flex-col-reverse in MessageThread
   renders newest at the bottom without JS scroll manipulation. *@

<PageTitle>Messages</PageTitle>

@if (_isLoading)
{
    <p><em>Loading…</em></p>
}
else
{
    @* Former MessagesDesktop composite, folded in 2026-07-18 (WU-ResponsiveMerge — single
       responsive tree, page owns its markup). Master/detail: conversation-list sidebar +
       thread pane side-by-side; the panes stack at narrow (list above, capped height, thread
       below — pure CSS, no list/thread swap logic). *@
    <div class="flex flex-col md:flex-row h-[calc(100vh-4rem)] overflow-hidden">

        @* ── Conversation list sidebar (stacks above the thread at narrow) ── *@
        <aside class="flex w-full max-h-64 md:w-72 md:max-h-none md:shrink-0 flex-col border-b md:border-b-0 md:border-r border-(--color-border) bg-(--color-surface)">
            <div class="border-b border-(--color-border) px-4 py-3">
                <div class="flex items-center justify-between">
                    <h1 class="inline-block rounded-md border border-(--color-border) bg-(--color-surface-raised) px-4 py-1.5 font-display text-xl font-semibold text-(--color-text)">Messages</h1>
                    <button type="button"
                            class="rounded-md bg-(--color-mission) px-2.5 py-1 text-xs font-medium text-white hover:bg-(--color-mission-hover)"
                            @onclick="HandleNewConversation">
                        New
                    </button>
                </div>

                @* Inbox / Archived toggle — sits on its own row because the sidebar is md:w-72,
                   too narrow to carry the segments beside the heading and New button.
                   Recipe mirrors NotificationsPage's view toggle. *@
                <div class="mt-2 flex overflow-hidden rounded-md border border-(--color-border) text-sm">
                    <button type="button"
                            class="flex-1 px-3 py-1.5 transition-colors @(_tab == MessageTab.Inbox ? "bg-(--color-action) text-(--color-text)" : "bg-(--color-surface-raised) hover:bg-(--color-surface-hover)")"
                            @onclick="() => SetTabAsync(MessageTab.Inbox)">
                        Inbox
                    </button>
                    <button type="button"
                            class="flex-1 px-3 py-1.5 transition-colors @(_tab == MessageTab.Archived ? "bg-(--color-action) text-(--color-text)" : "bg-(--color-surface-raised) hover:bg-(--color-surface-hover)")"
                            @onclick="() => SetTabAsync(MessageTab.Archived)">
                        Archived
                    </button>
                </div>
            </div>

            <div class="flex flex-1 flex-col gap-2 overflow-y-auto p-2">
                @if (_listError is not null)
                {
                    <InlineAlert Message="@_listError" />
                }
                @if (_loadingArchived)
                {
                    <p class="mt-4 text-center text-sm text-(--color-text-muted)">Loading&hellip;</p>
                }
                else if ((VisibleConversations?.Count ?? 0) == 0 && _listError is null)
                {
                    @* Per-tab copy. Inbox copy stays tab-scoped ("inbox is empty", not "no
                       conversations yet") because archived conversations may exist that this
                       view deliberately hasn't fetched — don't claim the user has none. *@
                    <p class="mt-4 text-center text-sm text-(--color-text-muted)">
                        @(_tab == MessageTab.Archived ? "No archived conversations." : "Your inbox is empty.")
                    </p>
                }
                else
                {
                    @foreach (var conv in VisibleConversations!)
                    {
                        <ConversationListItem Conversation="@conv"
                                             IsSelected="@(conv.ConversationId == ConversationId)" />
                    }
                }
            </div>
        </aside>

        @* ── Thread pane ── *@
        <section class="flex flex-1 flex-col overflow-hidden">
            <MessageThread Thread="EffectiveThread"
                           OnSendReply="HandleSendReplyAsync"
                           OnLoadOlderMessages="HandleLoadOlderAsync"
                           OnToggleArchive="HandleToggleArchiveAsync"
                           IsArchived="@(_threadHeader?.IsArchived ?? false)"
                           BusyArchiving="_archiving"
                           BusySending="_replying"
                           BusyLoading="_loadingOlder"
                           ErrorMessage="@_replyError" />
        </section>
    </div>

    @* Compose modal renders as a fixed overlay; position is independent of layout. *@
    <ComposeConversationModal IsOpen="_composeOpen"
                              RecipientPreset="_composePreset"
                              OnSubmit="HandleSubmitComposeAsync"
                              OnCancel="HandleCancelCompose"
                              Busy="_composeBusy"
                              ErrorMessage="@_composeError" />
}

@code {
    // ── Route / query params ──────────────────────────────────────────────────

    [Parameter] public int? ConversationId { get; set; }

    /// <summary>
    /// Pre-fill the compose modal recipient when navigating from a UserCard "Send PM" action.
    /// URL: <c>/messages?ComposeForUsername=Ash</c>
    /// </summary>
    [SupplyParameterFromQuery] private string? ComposeForUsername { get; set; }

    // ── Conversation list ─────────────────────────────────────────────────────

    private enum MessageTab { Inbox, Archived }

    /// <summary>
    /// The INBOX list only (non-archived). Persisted across the prerender→interactive handoff
    /// ([PersistentState] requires a public property) — the sidebar listing hydrates from the
    /// prerender payload. Thread state below stays ephemeral: loading it bundles a
    /// MarkConversationReadAsync write plus a post-mark-read listing refresh, both of which must
    /// run (plain assignments) on every load.
    /// </summary>
    [PersistentState] public IReadOnlyList<ConversationSummaryDto>? Conversations { get; set; }

    // The archived list is deliberately NOT persisted and NOT fetched on first load. Archiving is
    // the gesture that keeps the active set small, so the archived set is the one that grows
    // without bound — pulling it on every /messages visit would make a diligent user's inbox
    // monotonically heavier. Fetched on demand when the Archived tab is opened, dropped otherwise.
    private IReadOnlyList<ConversationSummaryDto>? _archivedConversations;

    // Ephemeral, like NotificationsPage's view/sort state — no querystring, resets on reload.
    private MessageTab _tab = MessageTab.Inbox;
    private bool _loadingArchived;
    private string? _listError;

    // ── Thread state ──────────────────────────────────────────────────────────

    private ConversationThreadDto? _threadHeader;

    /// <summary>
    /// Accumulated messages in newest-first order ([newest,...,oldest]).
    /// Page 1 messages are reversed on load; subsequent "load older" pages are appended.
    /// </summary>
    private List<MessageDto> _allMessages = [];
    private int _totalMessageCount;
    private int _currentPage;
    private int? _loadedConversationId = int.MinValue; // sentinel; no real ConversationId equals this

    // ── Compose modal ─────────────────────────────────────────────────────────

    private bool _composeOpen;
    private MessagingParticipantDto? _composePreset;
    private bool _composeBusy;
    private string? _composeError;

    // ── Busy / error ──────────────────────────────────────────────────────────

    private bool _isLoading = true;
    private bool _replying;
    private string? _replyError;
    private bool _loadingOlder;
    private bool _archiving;

    // ── Computed ──────────────────────────────────────────────────────────────

    /// <summary>The list the sidebar renders — whichever tab is active.</summary>
    private IReadOnlyList<ConversationSummaryDto>? VisibleConversations =>
        _tab == MessageTab.Archived ? _archivedConversations : Conversations;

    /// <summary>
    /// Projects _threadHeader + _allMessages into a ConversationThreadDto for the children.
    /// Returns null when no conversation is selected (children show "no conversation" state).
    /// </summary>
    private ConversationThreadDto? EffectiveThread => _threadHeader is null ? null
        : _threadHeader with { Messages = _allMessages, TotalMessageCount = _totalMessageCount };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        // ??= — restore-or-fetch idiom; every later listing refresh is a plain assignment.
        Conversations ??= await WriteService.GetConversationsAsync();

        // Resolve compose preset when arriving from a UserCard "Send PM" action.
        if (!string.IsNullOrWhiteSpace(ComposeForUsername))
        {
            _composePreset = await WriteService.FindUserByUsernameAsync(ComposeForUsername);
            _composeOpen = true;
        }

        if (ConversationId.HasValue)
        {
            await LoadThreadAsync();
        }

        _isLoading = false;
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Fires on every navigation to this route (same page, different ConversationId).
        // Skip until OnInitializedAsync has run; also skip when nothing changed.
        if (!_initialized) return;
        if (ConversationId == _loadedConversationId) return;

        _isLoading = true;
        _threadHeader = null;
        _allMessages = [];
        _totalMessageCount = 0;
        _replyError = null;

        if (ConversationId.HasValue)
        {
            await LoadThreadAsync();
        }
        else
        {
            _loadedConversationId = null;
        }

        _isLoading = false;
    }

    private async Task LoadThreadAsync()
    {
        if (!ConversationId.HasValue) return;

        _currentPage = 1;
        _loadedConversationId = ConversationId;

        try
        {
            var thread = await WriteService.GetConversationThreadAsync(
                ConversationId.Value, page: 1, MessagingConstants.ThreadPageSize);

            _threadHeader = thread;
            // Reverse so _allMessages is newest-first — matches flex-col-reverse rendering.
            _allMessages = thread.Messages.Reverse().ToList();
            _totalMessageCount = thread.TotalMessageCount;

            // Mark read + refresh list (updates unread counts in sidebar).
            await WriteService.MarkConversationReadAsync(ConversationId.Value);
            Conversations = await WriteService.GetConversationsAsync();

            // The sidebar renders _archivedConversations while the Archived tab is active, so
            // the mark-read above must be reflected there too — otherwise the just-read thread's
            // unread badge sits stale in the archived list until the tab is toggled.
            if (_tab == MessageTab.Archived)
                _archivedConversations = await LoadArchivedAsync();
        }
        catch (KeyNotFoundException)
        {
            Nav.NotFound();
        }
    }

    // ── Event handlers ────────────────────────────────────────────────────────

    private async Task HandleSendReplyAsync(string html)
    {
        if (!ConversationId.HasValue) return;

        _replying = true;
        _replyError = null;

        try
        {
            MessageDto sent = await WriteService.SendMessageAsync(ConversationId.Value, html);
            // Prepend newest message at index 0 — appears at bottom in flex-col-reverse.
            _allMessages.Insert(0, sent);
            _totalMessageCount++;
            // Refresh sidebar preview — both lists, since a reply to an archived thread must
            // update the archived list's preview/timestamp too (same reasoning as LoadThreadAsync).
            Conversations = await WriteService.GetConversationsAsync();
            if (_tab == MessageTab.Archived)
                _archivedConversations = await LoadArchivedAsync();
        }
        catch (MessagingValidationException ex)
        {
            _replyError = ex.Errors.Count > 0 ? ex.Errors[0] : "Validation failed.";
        }
        catch (Exception)
        {
            _replyError = "Failed to send message. Please try again.";
        }
        finally
        {
            _replying = false;
        }
    }

    private async Task HandleLoadOlderAsync()
    {
        if (!ConversationId.HasValue || _threadHeader is null) return;
        if (_totalMessageCount <= _allMessages.Count) return;

        _loadingOlder = true;

        try
        {
            _currentPage++;
            var olderThread = await WriteService.GetConversationThreadAsync(
                ConversationId.Value, _currentPage, MessagingConstants.ThreadPageSize);

            // Append reversed page (oldest of this page at the end = visually at top).
            _allMessages.AddRange(olderThread.Messages.Reverse());
        }
        finally
        {
            _loadingOlder = false;
        }
    }

    private async Task SetTabAsync(MessageTab tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        _listError = null;

        if (tab == MessageTab.Archived)
        {
            _loadingArchived = true;
            try
            {
                _archivedConversations = await LoadArchivedAsync();
            }
            catch (Exception)
            {
                // Same inline-error posture as the page's other user-clicked handlers —
                // a failed fetch shouldn't take out the whole page via the error boundary.
                _listError = "Failed to load archived conversations. Please try again.";
            }
            finally
            {
                _loadingArchived = false;
            }
        }
        else
        {
            // Drop it rather than cache — the next visit to the tab re-reads, so an archive
            // performed in between is never shown stale.
            _archivedConversations = null;
        }
    }

    /// <summary>
    /// Loads the archived-only list. The service exposes <c>includeArchived</c> (both) rather than
    /// an archived-only mode, so the archived subset is filtered here. That still meets the goal:
    /// the default Inbox load stays lean, and the wider read happens only when the user explicitly
    /// opens the Archived tab.
    /// </summary>
    private async Task<IReadOnlyList<ConversationSummaryDto>> LoadArchivedAsync()
    {
        IReadOnlyList<ConversationSummaryDto> all =
            await WriteService.GetConversationsAsync(includeArchived: true);
        return all.Where(c => c.IsArchived).ToList();
    }

    /// <summary>
    /// Archives or unarchives the open conversation, then returns to /messages with the pane
    /// cleared. Archiving is sticky — nothing else clears the flag — so the navigation is what
    /// makes the outcome unambiguous rather than leaving a now-filtered-out thread on screen.
    /// </summary>
    private async Task HandleToggleArchiveAsync()
    {
        if (!ConversationId.HasValue || _threadHeader is null) return;

        _archiving = true;
        _replyError = null;

        try
        {
            await WriteService.SetArchivedAsync(ConversationId.Value, !_threadHeader.IsArchived);

            // Back to a known state: Inbox tab, fresh listing, no thread selected.
            _tab = MessageTab.Inbox;
            _archivedConversations = null;
            Conversations = await WriteService.GetConversationsAsync();
            Nav.NavigateTo("/messages");
        }
        catch (Exception)
        {
            _replyError = "Failed to update this conversation. Please try again.";
        }
        finally
        {
            _archiving = false;
        }
    }

    private void HandleNewConversation()
    {
        _composePreset = null;
        _composeError = null;
        _composeOpen = true;
    }

    private void HandleCancelCompose()
    {
        _composeOpen = false;
        _composeError = null;
        _composePreset = null;
    }

    private async Task HandleSubmitComposeAsync(
        (string RecipientUsername, string Subject, string MessageHtml) args)
    {
        _composeBusy = true;
        _composeError = null;

        try
        {
            // Resolve recipient by username if not already preset.
            MessagingParticipantDto? recipient = _composePreset;
            if (recipient is null
                || !string.Equals(recipient.Username, args.RecipientUsername,
                    StringComparison.OrdinalIgnoreCase))
            {
                recipient = await WriteService.FindUserByUsernameAsync(args.RecipientUsername);
                if (recipient is null)
                {
                    _composeError = $"User \"{args.RecipientUsername}\" not found.";
                    return;
                }
            }

            int newId = await WriteService.StartConversationAsync(
                new StartConversationDto(recipient.UserId, args.Subject, args.MessageHtml));

            // Close the modal before navigating — same-route navigation reuses this component
            // instance, so _composeOpen survives into the new thread view otherwise
            // (found in the L4.5 browser pass).
            _composeOpen = false;
            _composePreset = null;

            // Navigate to the new thread — page will reload and show the fresh conversation.
            Nav.NavigateTo($"/messages/{newId}");
        }
        catch (MessagingPermissionException ex)
        {
            _composeError = ex.Message;
        }
        catch (MessagingValidationException ex)
        {
            _composeError = ex.Errors.Count > 0 ? ex.Errors[0] : "Validation failed.";
        }
        catch (Exception)
        {
            _composeError = "Failed to start conversation. Please try again.";
        }
        finally
        {
            _composeBusy = false;
        }
    }
}
