@namespace TheCanalaveLibrary.SharedUI

@* Universal confirm/cancel modal (spec §5.30.9). Cross-cutting container composite — no owning
   feature; cluster's feature is "modal/overlay dialogs" (canalave-conventions/SKILL.md Code
   Organization). First consumer is the chapter-comment spoiler reveal (audit/Comments.md Feature 26);
   also named for account deletion, leaving a group, deleting a custom list, unpublishing a story.

   Built on the shared Modal primitive (extracted WU-A11y, 2026-07-31 — see
   layer3.5-structure.md "Container Composite"). Public @bind-IsOpen contract is unchanged for all
   14 existing consumers. IsOpenChanged is wired explicitly (not via @bind-IsOpen on <Modal>)
   because backdrop-dismiss must be treated as Cancel — see HandleModalIsOpenChanged below. *@

<Modal IsOpen="IsOpen" IsOpenChanged="HandleModalIsOpenChanged"
       Title="@(Title ?? "Confirm")" ShowTitleHeading="@(Title is not null)" PanelClass="max-w-md">
    <ChildContent>
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <p class="text-(--color-text)">@Message</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-md border border-(--color-border) bg-surface px-3 py-1 text-text transition-colors hover:bg-(--color-surface-hover)"
                @onclick="Cancel">
            @CancelText
        </button>
        <button type="button" class="@(IsDestructive ? "bg-danger text-white hover:bg-(--color-danger-strong)" : "bg-(--color-action) text-(--color-text) hover:bg-(--color-action-hover)") rounded-md px-3 py-1 transition-colors"
                @onclick="Confirm">
            @ConfirmText
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Message { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Confirm";

    [Parameter] public string CancelText { get; set; } = "Cancel";

    [Parameter] public bool IsDestructive { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
        await Close();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    /// <summary>Modal's only closing action is backdrop-click (it has no Escape/trap yet — see
    /// Modal.razor). Treat that exactly like clicking Cancel: fire OnCancel, then close once. This
    /// intentionally does NOT use Modal's @bind-IsOpen sugar, which would only assign this
    /// component's local IsOpen field and never invoke this component's own IsOpenChanged —
    /// silently breaking upward propagation to ConfirmDialog's own @bind-IsOpen consumers.</summary>
    private async Task HandleModalIsOpenChanged(bool value)
    {
        if (!value && IsOpen)
        {
            await Cancel();
        }
    }
}
