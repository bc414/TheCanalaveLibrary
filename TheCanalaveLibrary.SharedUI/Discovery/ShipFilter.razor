@namespace TheCanalaveLibrary.SharedUI
@inject ITagReadService TagService

@* Ship filter axis (WU-TagFanon 5.5/5.6) — build a pairing criterion from character tags:
   stories containing a single pairing whose members cover every picked character, optionally
   constrained to romantic/platonic, include or exclude. AND across added ships, mirroring the
   tag axis. Member ids inherit hierarchy roll-up server-side. Ships are never persisted in
   SavedTagSelection and carry no URL representation (settled F15 scope + decision row 13).

   Injection is for the inline character typeahead ONLY — live fetch-on-user-input lives where the
   input is. Seed state (Initial*) is resolved by the page dispatcher and handed down; this
   component never re-fetches what it was given. TagFilter injects nothing because it delegates its
   typeahead to TagSelector; this component inlines its own. See layer3.5-structure.md
   §"Seed state vs. live fetch in filter components".

   Seeded ships re-sync on every parameter set until the user's first ship edit (MA-402, the same
   guard ResultsFilterPanel uses) — the dispatcher resolves member display names asynchronously, so
   a one-time OnInitialized snapshot would freeze on the empty pre-resolve lists. *@

<div class="flex flex-col gap-2">
    <label class="text-sm font-bold">Ships</label>

    @* Added ship criteria *@
    @if (_included.Count > 0 || _excluded.Count > 0)
    {
        <div class="flex flex-col gap-1">
            @for (int i = 0; i < _included.Count; i++)
            {
                int idx = i;
                <div class="flex items-center gap-2 text-sm">
                    <span class="text-(--color-text)">@ShipLabel(_included[idx], _includedNames[idx])</span>
                    <button type="button" @onclick="() => RemoveShip(idx, excluded: false)"
                            aria-label="Remove ship filter"
                            class="text-xs text-(--color-text-muted) hover:text-(--color-danger)">✕</button>
                </div>
            }
            @for (int i = 0; i < _excluded.Count; i++)
            {
                int idx = i;
                <div class="flex items-center gap-2 text-sm">
                    <span class="text-(--color-text-muted) line-through">@ShipLabel(_excluded[idx], _excludedNames[idx])</span>
                    <span class="text-xs text-(--color-text-muted)">(excluded)</span>
                    <button type="button" @onclick="() => RemoveShip(idx, excluded: true)"
                            aria-label="Remove excluded ship filter"
                            class="text-xs text-(--color-text-muted) hover:text-(--color-danger)">✕</button>
                </div>
            }
        </div>
    }

    @* Builder: pick 1-3 characters, choose kind, add as include or exclude *@
    <div class="flex flex-col gap-2 rounded-md border border-(--color-border) bg-(--color-surface) p-2">
        <div class="flex flex-wrap gap-1.5">
            @foreach (TagChipDto chip in _pickedMembers)
            {
                <TagChip Tag="chip" OnRemove="@(() => RemoveMember(chip))" />
            }
        </div>
        @if (_pickedMembers.Count < ShipFilterDto.MaxMembers)
        {
            <CanalaveTypeahead TItem="TagChipDto"
                               SearchMethod="SearchCharacters"
                               OnSelected="AddMember"
                               Placeholder="Add a character to the ship…"
                               NotFoundText="No characters found">
                <ResultTemplate Context="tag">
                    <span class="inline-flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-(--color-tagtype-character)"></span>
                        @tag.TagName
                    </span>
                </ResultTemplate>
            </CanalaveTypeahead>
        }
        <div class="flex flex-wrap items-center gap-2">
            <select @bind="_pairingKind" aria-label="Pairing kind"
                    class="rounded border border-(--color-border) bg-(--color-surface) px-2 py-1 text-xs text-(--color-text)">
                <option value="">Romantic or platonic</option>
                <option value="@CharacterPairingType.Romantic">Romantic</option>
                <option value="@CharacterPairingType.Platonic">Platonic</option>
            </select>
            <button type="button" @onclick="() => AddShipAsync(excluded: false)" disabled="@(_pickedMembers.Count == 0)"
                    class="rounded-md border border-(--color-border) px-2 py-1 text-xs text-(--color-text) hover:border-(--color-action-ink) disabled:opacity-50 transition-colors">
                Include ship
            </button>
            <button type="button" @onclick="() => AddShipAsync(excluded: true)" disabled="@(_pickedMembers.Count == 0)"
                    class="rounded-md border border-(--color-border) px-2 py-1 text-xs text-(--color-text-muted) hover:border-(--color-danger) disabled:opacity-50 transition-colors">
                Exclude ship
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>Fires with the full (included, excluded) ship lists on every change.</summary>
    [Parameter]
    public EventCallback<(IReadOnlyList<ShipFilterDto> Included, IReadOnlyList<ShipFilterDto> Excluded)> OnChanged { get; set; }

    /// <summary>Ships to pre-populate the include list with (restored filter, permalink, back-navigation).</summary>
    [Parameter] public IReadOnlyList<ShipFilterDto> InitialIncluded { get; set; } = [];

    /// <summary>Ships to pre-populate the exclude list with.</summary>
    [Parameter] public IReadOnlyList<ShipFilterDto> InitialExcluded { get; set; } = [];

    /// <summary>
    /// Display labels for <see cref="InitialIncluded"/>, index-aligned. Supplied by the dispatcher —
    /// this component builds labels at pick time from selected chips and cannot rebuild them from
    /// member ids alone (it has no id→name read of its own for seeds, by design).
    /// </summary>
    [Parameter] public IReadOnlyList<string> InitialIncludedNames { get; set; } = [];

    /// <summary>Display labels for <see cref="InitialExcluded"/>, index-aligned.</summary>
    [Parameter] public IReadOnlyList<string> InitialExcludedNames { get; set; } = [];

    private readonly List<TagChipDto> _pickedMembers = [];
    private string _pairingKind = "";

    private readonly List<ShipFilterDto> _included = [];
    private readonly List<ShipFilterDto> _excluded = [];
    // Parallel display-name lists (one string per ship, members joined).
    private readonly List<string> _includedNames = [];
    private readonly List<string> _excludedNames = [];

    // Stops the re-seed loop once the user edits ships themselves (MA-402).
    private bool _userHasInteracted;

    protected override void OnParametersSet()
    {
        if (_userHasInteracted) return;

        Seed(_included, _includedNames, InitialIncluded, InitialIncludedNames);
        Seed(_excluded, _excludedNames, InitialExcluded, InitialExcludedNames);
    }

    // Ships and their labels are replaced wholesale — a partial seed would desynchronise the two
    // parallel lists the markup indexes in lockstep.
    private static void Seed(
        List<ShipFilterDto> ships,
        List<string> names,
        IReadOnlyList<ShipFilterDto> seedShips,
        IReadOnlyList<string> seedNames)
    {
        ships.Clear();
        names.Clear();
        ships.AddRange(seedShips);
        for (int i = 0; i < seedShips.Count; i++)
            names.Add(i < seedNames.Count ? seedNames[i] : "…");
    }

    private async Task<IEnumerable<TagChipDto>> SearchCharacters(string term)
    {
        List<TagChipDto> results = await TagService.SearchTagChipsAsync(TagTypeEnum.Character, term);
        return results.Where(t => _pickedMembers.All(p => p.TagId != t.TagId));
    }

    private void AddMember(TagChipDto chip)
    {
        if (_pickedMembers.Count < ShipFilterDto.MaxMembers && _pickedMembers.All(p => p.TagId != chip.TagId))
            _pickedMembers.Add(chip);
    }

    private void RemoveMember(TagChipDto chip) => _pickedMembers.Remove(chip);

    private async Task AddShipAsync(bool excluded)
    {
        if (_pickedMembers.Count == 0) return;

        _userHasInteracted = true;

        CharacterPairingType? kind = Enum.TryParse(_pairingKind, out CharacterPairingType parsed) ? parsed : null;
        ShipFilterDto ship = new()
        {
            MemberTagIds = _pickedMembers.Select(p => p.TagId).ToList(),
            PairingType = kind
        };
        string names = ShipFilterDto.JoinMemberNames(kind, _pickedMembers.Select(p => p.TagName));

        (excluded ? _excluded : _included).Add(ship);
        (excluded ? _excludedNames : _includedNames).Add(names);
        _pickedMembers.Clear();
        _pairingKind = "";
        await EmitAsync();
    }

    private async Task RemoveShip(int index, bool excluded)
    {
        _userHasInteracted = true;
        (excluded ? _excluded : _included).RemoveAt(index);
        (excluded ? _excludedNames : _includedNames).RemoveAt(index);
        await EmitAsync();
    }

    private Task EmitAsync() => OnChanged.InvokeAsync((_included.ToList(), _excluded.ToList()));

    private static string ShipLabel(ShipFilterDto ship, string names) =>
        ship.PairingType is null ? names : $"{names} ({ship.PairingType})";
}
