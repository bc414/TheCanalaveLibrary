@page "/discover"
@page "/discover/selection/{SelectionId:int}/{*Slug}"
@namespace TheCanalaveLibrary.SharedUI
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject IStoryReadService StoryReadService
@inject IUserStoryInteractionReadService InteractionReadService
@inject IDiscoveryDefaultsReadService DiscoveryDefaults
@inject ITagReadService TagReadService
@inject ISavedTagSelectionReadService SelectionReadService
@inject DiscoveryFilterStore FilterStore
@inject IUserSettingsService SettingsService

@* SearchPage — /discover (WU28, spec §5.3 / §5.28; former SearchDesktop composite folded in
   2026-07-18, WU-ResponsiveMerge — single responsive tree, page owns its markup).
   Loads §8.7 defaults on init and preloads a random batch (area is never blank).
   AllowAnonymous: discovery is public.
   Layout: ResultsFilterPanel sidebar + StoryDeck with Give-me-more / pagination; the sidebar
   stacks above the deck at narrow (desktop composition is the base).

   Two modes keyed on _filter.Sort:
   - Random: Items accumulates across batches; "Give me more" appends a fresh draw.
   - Sorted (DatePublished / Relevance): offset pagination via GetListingsAsync.

   [PersistentState] on DefaultExcludedInteractions and Items eliminates the prerender→interactive
   double fetch on full document loads (layer5-wasm.md §"Avoiding the double fetch"). Only the
   INITIAL load reads the persisted payload — every user-driven search/page/batch afterward is a
   plain assignment to the same properties. Per-viewer interaction states (_states) stay ephemeral
   and are reloaded on hydration.

   Two routes (decision row 13):
   - /discover — the ordinary search surface. Carries NO filter state in the URL, ever. Filters
     instead survive navigation device-locally via DiscoveryFilterStore (localStorage, ids only).
   - /discover/selection/{SelectionId:int}/{*Slug} — a public SavedTagSelection's permalink,
     following the story-slug contract: the id is the source of truth and the slug is a decorative
     tail that is never parsed, so renaming a selection never breaks a link. Seeds the tag axis from
     the artifact and otherwise behaves exactly like /discover — sort and interaction exclusions
     stay the VIEWER's own §8.7 defaults, which is what keeps a saved selection a tag combination
     rather than a saved query (layer2-services.md §"Saved Tag Selections Persist Only the Tag
     Axis"). Both permalink gates (IsPublic, owner's ProfileVisibility) are enforced server-side in
     GetPublicSelectionByIdAsync; every failure mode is one indistinguishable null. *@

@* PageTitle + h1 added by the WU-A11y browser pass (2026-07-31) — axe flagged both
   document-title and page-has-heading-one missing here. sr-only, not a visible header row: this
   page has no existing header band, and adding one is a visual-design decision (Phase-3 L4 sweep
   territory), not a structural fix. A screen-reader-only h1 satisfies the same landmark/heading
   need without it. *@
<PageTitle>Discover</PageTitle>
<h1 class="sr-only">Discover</h1>

@* ── Permalink chrome (only on /discover/selection/…) ──────────────────────────────────── *@
@if (_selection is not null)
{
    <div class="px-3 pt-4 md:px-4">
        <SelectionPermalinkBanner Selection="@_selection" CurrentUserId="@_currentUserId" />
    </div>
}
else if (_selectionUnavailable)
{
    @* Missing, unpublished and not-visible collapse to one message on purpose — distinguishing
       them would turn the permalink into an existence oracle for private profiles. *@
    <div class="px-3 pt-4 md:px-4">
        <p class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4 text-sm text-(--color-text-muted)">
            That saved tag selection isn't available. Showing everything instead.
        </p>
    </div>
}

<div class="flex flex-col gap-6 items-start px-3 py-4 md:flex-row md:px-4">

    @* ── ResultsFilterPanel sidebar (stacks above the deck at narrow) ────────────────────
       A plain div, not <aside>: WU-A11y browser pass (2026-07-31) found axe's
       landmark-complementary-is-top-level violation here — this panel is nested inside
       <main> (MainLayout), but ARIA's complementary role is defined as a top-level
       landmark, sibling to main, not a descendant. It's also semantically the better fit:
       these filter controls are integral to the page's primary search task, not tangential
       "complementary" content the way a related-links widget would be. *@
    <div class="w-full md:w-72 md:shrink-0 rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4">
        <h2 class="mb-3 text-sm font-bold text-(--color-text-muted) uppercase tracking-wide">Filters</h2>
        <ResultsFilterPanel OnSearch="@HandleFilterChangedAsync"
                            InitialFilter="@_filter"
                            InitialIncludedTags="@_includedTagChips"
                            InitialExcludedTags="@_excludedTagChips"
                            InitialIncludedShipNames="@_includedShipNames"
                            InitialExcludedShipNames="@_excludedShipNames"
                            AvailableSorts="@AvailableSorts"
                            ShowTextSearch="true"
                            ShowTagFilter="true"
                            ShowInteractionFilters="true"
                            ShowTagIncludeModeToggle="true" />
    </div>

    @* ── Main area: StoryDeck + mode-dependent controls ─────────────────────────────────── *@
    <div class="w-full min-w-0 flex-1 flex flex-col gap-4">

        @if (IsRandomMode)
        {
            @* Random mode: no pagination; deck TotalCount == Items.Count forces TotalPages=1
               so PaginationControls self-hides. "Give me more" button appears below the deck. *@
            <StoryDeck Stories="@(Items ?? [])"
                       UserStoryInteractionStates="@_states"
                       CurrentUserId="@_currentUserId"
                       EmptyMessage="No stories found for these filters. Try broadening your search."
                       CurrentPage="1"
                       PageSize="@(Items?.Length ?? 0)"
                       TotalCount="@(Items?.Length ?? 0)"
                       OnReport="@(id => _reportDialog.OpenAsync(ReportedEntityType.Story, id))" />

            <button type="button"
                    class="self-center rounded-md bg-(--color-mission) px-5 py-2 text-sm font-medium text-white hover:bg-(--color-mission-hover) active:bg-(--color-mission-hover) transition-colors disabled:opacity-50"
                    disabled="@_isLoadingMore"
                    @onclick="HandleLoadMoreAsync">
                @(_isLoadingMore ? "Loading…" : "Give me more")
            </button>
        }
        else
        {
            @* Sorted mode: real pagination; no give-me-more button. *@
            <StoryDeck Stories="@(Items ?? [])"
                       UserStoryInteractionStates="@_states"
                       CurrentUserId="@_currentUserId"
                       EmptyMessage="No stories found for these filters. Try broadening your search."
                       CurrentPage="@_filter.Page"
                       PageSize="@_filter.PageSize"
                       TotalCount="@_totalCount"
                       OnPageChanged="@HandlePageChangedAsync"
                       OnReport="@(id => _reportDialog.OpenAsync(ReportedEntityType.Story, id))" />
        }

        <ReportDialog @ref="_reportDialog" />
    </div>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Permalink route only — the selection whose tag axis seeds this visit.</summary>
    [Parameter] public int? SelectionId { get; set; }

    /// <summary>
    /// Decorative slug tail. Never parsed and never validated: the id is the source of truth, so a
    /// stale or hand-edited slug still resolves (the story-slug contract, minus the SEO-driven
    /// canonical 301 — selections are out of the sitemap).
    /// </summary>
    [Parameter] public string? Slug { get; set; }

    // Reader-setting default (WU-DiscoveryOverrideUI, closes tracker item B7's "stubbed to a
    // constant 20" clause). Resolved from ReaderSettingsDto.DefaultPaginationSize in
    // OnInitializedAsync for authenticated viewers; anonymous viewers keep this default.
    private int _randomBatchSize = 20;

    private int? _currentUserId;
    private StoryFilterDto _filter = new() { Sort = DefaultSortOrder.Random };

    // §8.7 default exclusions for the SearchPage surface — fetched at prerender, restored at
    // hydration ([PersistentState] requires a public property). Array, not IReadOnlyList: STJ
    // round-trips concrete types most predictably in the persisted payload.
    [PersistentState]
    public UserStoryInteractionTypeEnum[]? DefaultExcludedInteractions { get; set; }

    // Accumulation array — appended to in random mode; replaced on sort change or filter change.
    // Persisted so the initial random batch survives the prerender→interactive handoff; later
    // batches/pages overwrite it with plain assignments.
    [PersistentState]
    public StoryListingDto[]? Items { get; set; }

    // In random mode TotalCount is Items.Length (deterministic proxy — see LoadRandomBatchAsync),
    // so it is recomputed on restore rather than persisted.
    private int _totalCount;
    private IReadOnlyDictionary<int, UserStoryInteractionStateDto> _states =
        new Dictionary<int, UserStoryInteractionStateDto>();

    // Resolved tag chips for seeding the panel (loaded when InitialFilter carries tag ids).
    private IReadOnlyList<TagChipDto> _includedTagChips = [];
    private IReadOnlyList<TagChipDto> _excludedTagChips = [];

    // Resolved ship labels for seeding ShipFilter — index-aligned with _filter.Included/ExcludedShips.
    // ShipFilter builds labels from picked chips and cannot rebuild them from bare member ids, so
    // seed labels are the dispatcher's job (layer3.5-structure.md §"Seed state vs. live fetch").
    private IReadOnlyList<string> _includedShipNames = [];
    private IReadOnlyList<string> _excludedShipNames = [];

    private bool _isLoadingMore;
    private bool _restoreAttempted;

    // Permalink state. _selectionUnavailable covers missing/unpublished/not-visible alike.
    private SavedTagSelectionDetailDto? _selection;
    private bool _selectionUnavailable;

    // ── Presentation state (from the former SearchDesktop composite) ──────────────
    private ReportDialog _reportDialog = default!;

    private bool IsRandomMode => _filter.Sort == DefaultSortOrder.Random;

    private static readonly IReadOnlyList<DefaultSortOrder> AvailableSorts =
        [DefaultSortOrder.Random, DefaultSortOrder.DatePublished, DefaultSortOrder.Relevance];

    protected override async Task OnInitializedAsync()
    {
        // Resolve current user id (nullable — anonymous viewers are fully supported).
        if (AuthState is not null)
        {
            var state = await AuthState;
            string? idClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idClaim, out int userId)) _currentUserId = userId;
        }

        // Seed filter with §8.7 defaults for the SearchPage surface (??= restore-or-fetch idiom).
        DefaultExcludedInteractions ??=
            [.. await DiscoveryDefaults.GetDefaultExcludedInteractionsAsync(SiteSearchModes.SearchPage)];

        _filter = _filter with { ExcludedInteractions = DefaultExcludedInteractions };

        // Reader-setting defaults (WU-DiscoveryOverrideUI): DefaultPaginationSize governs the
        // random-mode batch size; DefaultSearchSort seeds the initial sort. Anonymous viewers keep
        // the hardcoded fallbacks (_randomBatchSize=20, Sort=Random from _filter's field
        // initializer). A later device-local restore (OnAfterRenderAsync) still wins over both —
        // it runs after this and only applies when it narrows differently (decision row 13).
        if (_currentUserId is int)
        {
            ReaderSettingsDto reader = (await SettingsService.GetMySettingsAsync()).Reader;

            if (reader.DefaultPaginationSize > 0)
                _randomBatchSize = reader.DefaultPaginationSize;

            // Only DatePublished is valid as this surface's INITIAL sort besides Random: Relevance
            // needs a live text query (none exists pre-load — ResultsFilterPanel itself hides
            // Relevance from its dropdown for the same reason), and Score/RecentlyRead aren't in
            // this surface's AvailableSorts at all. A default set to either falls back to Random
            // rather than silently misapplying an inapplicable sort.
            if (reader.DefaultSearchSort == DefaultSortOrder.DatePublished)
                _filter = _filter with { Sort = DefaultSortOrder.DatePublished };
        }

        // Permalink: the artifact contributes the tag axis only — sort and interaction exclusions
        // above stay this viewer's own, which is what keeps it a shared tag combination rather than
        // a shared query. Runs before the first load so the batch already reflects the selection.
        if (SelectionId is int selectionId)
            await SeedFromSelectionAsync(selectionId);

        if (Items is null)
        {
            // Pre-load the initial batch/page — spec §5.28: area is never blank on load. Random
            // is still the common case (the field initializer's default, and every anonymous
            // viewer), but an authenticated viewer's DefaultSearchSort may have just set Sort to
            // DatePublished above, so this must dispatch on the resolved mode, not assume Random.
            if (IsRandomMode)
                await LoadRandomBatchAsync(append: false);
            else
                await LoadSortedPageAsync();
        }
        else
        {
            // Restored from the prerender payload: no listing refetch. Recompute the random-mode
            // TotalCount proxy and reload only the per-viewer interaction states — ephemeral
            // supplementary state, deterministic per viewer, so the re-fetch is flicker-free
            // (same treatment as StoryPage's _usiState).
            _totalCount = Items.Length;
            await LoadInteractionStatesAsync();
        }
    }

    // ── Permalink seeding (decision row 13) ────────────────────────────────────────────────────────

    private async Task SeedFromSelectionAsync(int selectionId)
    {
        // Both gates (IsPublic, owner's ProfileVisibility) live in the service; every failure mode
        // returns the same null, so this page cannot leak which one fired.
        _selection = await SelectionReadService.GetPublicSelectionByIdAsync(selectionId);
        if (_selection is null)
        {
            _selectionUnavailable = true;
            return;
        }

        _filter = _filter with
        {
            IncludedTagIds = [.. _selection.IncludedTags.Select(t => t.TagId)],
            ExcludedTagIds = [.. _selection.ExcludedTags.Select(t => t.TagId)],
            Page = 1
        };

        // The detail DTO already carries hydrated chips — seeding the panel needs no second read.
        _includedTagChips = _selection.IncludedTags;
        _excludedTagChips = _selection.ExcludedTags;
    }

    // ── Device-local filter restore (decision row 13) ──────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Waits for interactivity: localStorage needs JS, which is unavailable during prerender.
        // The restored filter therefore arrives as a LATE seed — which is exactly what the panel's
        // MA-402 re-seed-until-first-interaction guard exists to absorb.
        if (!firstRender || _restoreAttempted) return;
        _restoreAttempted = true;

        // A permalink is explicit intent: never let the device's remembered filter overwrite the
        // selection someone deliberately followed a link to.
        if (SelectionId is not null) return;

        await TryRestoreFilterAsync();
    }

    private async Task TryRestoreFilterAsync()
    {
        DiscoveryFilterSnapshot? snapshot = await FilterStore.LoadAsync(DiscoveryFilterStore.FilterKey(_currentUserId));
        if (snapshot is null) return;

        // Ids only on disk: resolve what the viewer can still see, and prune the rest. A tag deleted
        // or gated since the save silently drops out rather than filtering the page into nothing.
        int[] tagIds = snapshot.AllTagIds();
        HashSet<int> visible = tagIds.Length == 0
            ? []
            : [.. (await TagReadService.GetTagChipsByIdsAsync(tagIds)).Select(c => c.TagId)];

        StoryFilterDto restored = snapshot.ToFilter(visible);

        // Nothing to do when the restored filter would produce the batch already on screen.
        if (!NarrowsDifferently(restored)) return;

        _filter = restored;
        await ResolveSeedDisplayAsync();

        Items = [];
        _totalCount = 0;
        if (IsRandomMode)
            await LoadRandomBatchAsync(append: false);
        else
            await LoadSortedPageAsync();

        StateHasChanged();
    }

    /// <summary>
    /// True when applying <paramref name="candidate"/> would change what is currently displayed.
    /// Guards against a pointless second query on every visit whose saved filter is just the
    /// default one. Record equality can't do this — <c>StoryFilterDto</c>'s list members compare
    /// by reference.
    /// </summary>
    private bool NarrowsDifferently(StoryFilterDto candidate) =>
        !string.IsNullOrWhiteSpace(candidate.TextQuery)
        || candidate.IncludedTagIds.Count > 0
        || candidate.ExcludedTagIds.Count > 0
        || candidate.IncludedShips.Count > 0
        || candidate.ExcludedShips.Count > 0
        || candidate.IncludeMode != _filter.IncludeMode
        || candidate.Sort != _filter.Sort
        || !candidate.ExcludedInteractions.Order().SequenceEqual(_filter.ExcludedInteractions.Order());

    // ── Filter changes (panel Apply) ──────────────────────────────────────────────────────────────

    private async Task HandleFilterChangedAsync(StoryFilterDto filter)
    {
        _filter = filter with { Page = 1 };

        // Resolve seed display data for the new filter (feeds the panel on the next render).
        await ResolveSeedDisplayAsync();

        // Remember it for the next visit on this device. Ids only, per-viewer key; a refused write
        // (private mode, quota) costs nothing but the restore, so it isn't surfaced.
        await FilterStore.SaveAsync(
            DiscoveryFilterStore.FilterKey(_currentUserId),
            DiscoveryFilterSnapshot.From(_filter));

        // Reset accumulation on any filter/mode change.
        Items = [];
        _totalCount = 0;

        if (_filter.Sort == DefaultSortOrder.Random)
            await LoadRandomBatchAsync(append: false);
        else
            await LoadSortedPageAsync();
    }

    // ── Sorted pagination ─────────────────────────────────────────────────────────────────────────

    private async Task HandlePageChangedAsync(int page)
    {
        _filter = _filter with { Page = page };
        await LoadSortedPageAsync();
    }

    private async Task LoadSortedPageAsync()
    {
        (Items, _totalCount) = await StoryReadService.GetListingsAsync(_filter);
        await LoadInteractionStatesAsync();
    }

    // ── Random mode ───────────────────────────────────────────────────────────────────────────────

    private async Task HandleLoadMoreAsync()
    {
        _isLoadingMore = true;
        await LoadRandomBatchAsync(append: true);
        _isLoadingMore = false;
    }

    private async Task LoadRandomBatchAsync(bool append)
    {
        StoryListingDto[] batch = await StoryReadService.GetRandomBatchAsync(_filter, _randomBatchSize);

        StoryListingDto[] items = append ? [.. Items ?? [], .. batch] : batch;
        Items = items;
        // In random mode TotalCount is not meaningful (stateless draw); use item count as a proxy
        // so StoryDeck's PaginationControls self-hides (TotalCount == PageSize == Items.Count → TotalPages=1).
        _totalCount = items.Length;

        await LoadInteractionStatesAsync();
    }

    // ── Shared helpers ────────────────────────────────────────────────────────────────────────────

    private async Task LoadInteractionStatesAsync()
    {
        if (_currentUserId.HasValue && Items is { Length: > 0 })
        {
            _states = await InteractionReadService.GetStatesByStoryIdsAsync(
                [.. Items.Select(i => i.StoryId)]);
        }
        else
        {
            _states = new Dictionary<int, UserStoryInteractionStateDto>();
        }
    }

    /// <summary>
    /// Resolves every piece of display data the filter panel needs to render <c>_filter</c> —
    /// tag chips and ship labels. Seed resolution is the dispatcher's job; the panel and the axis
    /// components never fetch it themselves.
    /// </summary>
    private async Task ResolveSeedDisplayAsync()
    {
        await ResolveTagChipsAsync();
        await ResolveShipNamesAsync();
    }

    private async Task ResolveTagChipsAsync()
    {
        _includedTagChips = _filter.IncludedTagIds.Count > 0
            ? await TagReadService.GetTagChipsByIdsAsync(_filter.IncludedTagIds)
            : [];

        _excludedTagChips = _filter.ExcludedTagIds.Count > 0
            ? await TagReadService.GetTagChipsByIdsAsync(_filter.ExcludedTagIds)
            : [];
    }

    private async Task ResolveShipNamesAsync()
    {
        // One batch read covers both axes — ships are small, but a per-ship call would be an N+1.
        int[] memberIds =
        [
            .. _filter.IncludedShips.Concat(_filter.ExcludedShips)
                .SelectMany(s => s.MemberTagIds)
                .Distinct()
        ];

        if (memberIds.Length == 0)
        {
            _includedShipNames = [];
            _excludedShipNames = [];
            return;
        }

        Dictionary<int, string> namesById = (await TagReadService.GetTagChipsByIdsAsync(memberIds))
            .ToDictionary(c => c.TagId, c => c.TagName);

        _includedShipNames = [.. _filter.IncludedShips.Select(s => Label(s, namesById))];
        _excludedShipNames = [.. _filter.ExcludedShips.Select(s => Label(s, namesById))];

        // A member the viewer can no longer resolve renders as "?" rather than vanishing — the
        // ship is still filtering, so hiding the member would misrepresent the active query.
        static string Label(ShipFilterDto ship, Dictionary<int, string> namesById) =>
            ShipFilterDto.JoinMemberNames(
                ship.PairingType,
                ship.MemberTagIds.Select(id => namesById.TryGetValue(id, out string? name) ? name : "?"));
    }
}
