@page "/group/{GroupId:int}/{*GroupSlug}"
@namespace TheCanalaveLibrary.SharedUI
@inject IGroupWriteService GroupService
@inject IStoryReadService StoryService
@inject IUserStoryInteractionReadService InteractionService
@inject IBlogPostReadService BlogPostService
@inject NavigationManager Nav
@inject IPublicUrlProvider PublicUrlProvider
@inject ILogger<GroupPage> Logger
@using TheCanalaveLibrary.Core
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging

@* Group detail page — /group/{id}/{slug} (WU32; former GroupDesktop composite folded in
   2026-07-18, WU-ResponsiveMerge — single responsive tree, page owns its markup).
   Slug is cosmetic; only GroupId is the key (audience filter may return null for hidden Mature groups).
   Resolves CurrentUserId from the auth cascade (never injects IActiveUserContext — SharedUI rule).
   Batch-loads: group detail, story listings, interaction states, blog posts in parallel.
   [PersistentState] on Group/Stories/BlogPosts/TotalBlogPosts eliminates the prerender→interactive
   double-fetch; per-viewer state (_currentUserRole, _interactionStates) stays ephemeral — same
   judgment as StoryPage's _usiState (deterministic per viewer, re-fetch is flicker-free).
   WU32.

   Story↔folder membership (WU-GroupsL5b, 2026-07-24 — closes hidden-deferrals B6): the folder
   tree now renders each folder's actual stories (title + link) for EVERY viewer — visibility was
   never gated, only the group/folder write actions are (settled WU32: RequireAdminAsync). Admins
   additionally get a per-story "move to folder" control (StoryDeck's CardOverlay slot — see
   CustomListPage.OwnerRemoveOverlay for the same pattern) and a per-folder unassign (×) control,
   plus the group-removal action HandleStoryRemovedAsync already implemented but previously
   unwired to any button. Group.Stories/GroupFolderDto.Stories carry GroupStoryDto (GroupStoryId +
   StoryId) — every write method here is keyed by GroupStoryId, not StoryId. *@

@if (_isLoading)
{
    <PageTitle>Group</PageTitle>
    <p class="p-4 text-(--color-text-muted)"><em>Loading…</em></p>
}
else if (_gate is not null && Group is null)
{
    @* Mature interstitial (WU-AccessGate): M-audience group, not consented. *@
    <ContentGateInterstitial Metadata="@_gate" />
}
else if (Group is null)
{
    <PageTitle>Group not found</PageTitle>
    <p class="p-4 text-(--color-danger)">Group not found.</p>
}
else
{
    <PageTitle>@Group.GroupName</PageTitle>
    <SocialMetaTags Title="@Group.GroupName" Description="@OgDescription" ImageUrl="@OgImageUrl" Url="@OgUrl" OgType="website"/>
    @if (Group.AudienceType == GroupAudienceType.Mature)
    {
        @* Adult labels on the revealed branch too — the URL is adult regardless of consent. *@
        <AdultContentMetaTags />
    }

    <div class="mx-auto max-w-6xl px-3 py-4 md:px-4 md:py-8 flex flex-col gap-6 md:gap-8">

        @* ── Group header ─────────────────────────────────────────────────────────── *@
        <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex flex-col gap-1">
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-3xl font-bold text-(--color-text)">@Group.GroupName</h1>
                        <span class="@GroupDisplayFormat.AudienceBadgeClasses(Group.AudienceType) rounded px-2 py-0.5 text-xs font-medium ring-1">
                            @GroupDisplayFormat.AudienceBadgeLabel(Group.AudienceType)
                        </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-(--color-text-muted)">
                        <span>@Group.MemberCount @(Group.MemberCount == 1 ? "member" : "members")</span>
                        @if (Group.CreatorDisplayName is not null)
                        {
                            <span>·</span>
                            <span>Created by
                                <a href="/user/@Group.CreatorId"
                                   class="text-(--color-action-ink) hover:underline">@Group.CreatorDisplayName</a>
                            </span>
                        }
                        <span>·</span>
                        <span>@Group.DateCreated.ToString("MMM d, yyyy")</span>
                    </div>
                </div>

                @* ── Membership controls ──────────────────────────────────────────── *@
                <div class="flex items-center gap-3">
                    @if (_currentUserId is not null)
                    {
                        @if (_currentUserRole is null)
                        {
                            <button type="button" @onclick="HandleJoinAsync"
                                    class="rounded-md bg-(--color-action) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-action-hover)">
                                Join Group
                            </button>
                        }
                        else
                        {
                            <span class="text-sm text-(--color-text-muted)">
                                @(_currentUserRole == GroupRole.Admin ? "Admin" : "Member")
                            </span>
                            <button type="button" @onclick="HandleLeaveClickedAsync"
                                    class="rounded-md border border-(--color-border) bg-(--color-surface) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-surface-hover)">
                                Leave
                            </button>
                        }
                        @if (_currentUserRole == GroupRole.Admin)
                        {
                            <a href="/group/@Group.GroupId/edit"
                               class="rounded-md border border-(--color-border) bg-(--color-surface) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-surface-hover)">
                                Edit Group
                            </a>
                        }
                    }
                </div>
            </div>

            @* Join/leave refusals, beside the controls that caused them (error-handling.md: a refusal is
               never a toast). Self-hides when empty. *@
            <ErrorAlert Message="@_membershipError" ShowSignIn="@_membershipErrorIsSessionExpired" />

            @if (!string.IsNullOrWhiteSpace(Group.Description))
            {
                <p class="text-sm text-(--color-text) leading-relaxed max-w-2xl">@Group.Description</p>
            }

            @* Owner ruling D13 edge (b): an admin-less group waits for a site moderator. Affordance only —
               AssignGroupAdminAsync's guards are the control. A refusal reloads the group and keeps its
               message here, where the panel was: the reload may hide the panel (error-handling.md). *@
            @if (_viewerIsModerator && _rescueRefusal is not null)
            {
                <ErrorAlert Message="@_rescueRefusal" />
            }
            @if (_viewerIsModerator && Group.AdminCount == 0)
            {
                <GroupAdminRescuePanel GroupId="@Group.GroupId" OnAssigned="LoadGroupAsync" OnStale="HandleRescueStaleAsync" />
            }
        </div>

        @* One ReportDialog host per page, at page level so the stories and the blog section both reach it
           (tracker B17; the WU34 one-host rule). *@
        <ReportDialog @ref="_reportDialog" />

        @* The sole admin's Leave confirms first (D13's recommended rider: warn rather than cure). *@
        <ConfirmDialog @bind-IsOpen="_confirmLastAdminLeaveOpen" Title="Leave as the only admin?" IsDestructive="true"
                       ConfirmText="Leave group" CancelText="Stay" OnConfirm="HandleLeaveAsync">
            <p class="text-(--color-text)">
                You're this group's only admin. If you leave, it will have no admin until a site moderator
                assigns one, and no one will be able to edit the group, manage its folders or remove its stories.
            </p>
        </ConfirmDialog>

        @* ── Two-column layout: main | sidebar ────────────────────────────────────── *@
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_280px]">

            @* ── Left column: stories + blog posts + comments ─────────────────────── *@
            <div class="flex flex-col gap-8">

                @* Stories ─────────────────────────────────────────────────────────── *@
                <section class="flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-(--color-text)">Stories</h2>
                        @if (_currentUserRole is not null)
                        {
                            <button type="button" @onclick="ToggleAddStory"
                                    class="text-sm text-(--color-action-ink) hover:underline">
                                @(_showAddStory ? "Cancel" : "+ Add Story")
                            </button>
                        }
                    </div>

                    @* Add/remove/file refusals for the stories below. *@
                    <ErrorAlert Message="@_storyError" ShowSignIn="@_storyErrorIsSessionExpired" />

                    @* ── Inline add-story form (members only) — WU42: title typeahead replaces the
                       old raw numeric Story ID input. *@
                    @if (_showAddStory)
                    {
                        <div class="rounded-lg border border-(--color-border) bg-(--color-surface) p-4 flex flex-col gap-3" role="group" aria-labelledby="group-add-story-label">
                            <span id="group-add-story-label" class="text-sm font-semibold text-(--color-text)">Add a story to this group</span>
                            <StoryTitlePicker OnStorySelected="HandleAddStoryAsync"
                                              Placeholder="Type to search for a story..." />
                            <div class="flex gap-2">
                                <button type="button" @onclick="() => _showAddStory = false"
                                        class="rounded-md border border-(--color-border) px-3 py-1.5 text-sm text-(--color-text) hover:bg-(--color-surface-hover)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }

                    <MatureDisclosureLine Items="@_gatedItems" />
                    <StoryDeck Stories="@(Stories ?? [])"
                               UserStoryInteractionStates="_interactionStates"
                               CurrentUserId="_currentUserId"
                               EmptyMessage="No stories in this group yet."
                               OnReport="@(id => _reportDialog.OpenAsync(ReportedEntityType.Story, id))"
                               CardOverlay="@AdminStoryOverlay" />
                    <ConfirmDialog @bind-IsOpen="_confirmRemoveOpen" Title="Remove story?" IsDestructive="true"
                                   ConfirmText="Remove" CancelText="Cancel" OnConfirm="HandleRemoveConfirmedAsync">
                        <p class="text-(--color-text)">
                            Remove "@_pendingRemoveStoryTitle" from this group? This can't be undone &mdash;
                            the story itself is not deleted.
                        </p>
                    </ConfirmDialog>
                </section>

                @* Blog posts ─────────────────────────────────────────────────────── *@
                <section class="flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-(--color-text)">Blog Posts</h2>
                        @if (_currentUserRole is not null)
                        {
                            <a href="/group/@Group.GroupId/blog/new"
                               class="text-sm text-(--color-action-ink) hover:underline">+ New Post</a>
                        }
                    </div>
                    @if (BlogPosts is null || BlogPosts.Length == 0)
                    {
                        <p class="text-sm text-(--color-text-muted)">No blog posts yet.</p>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3">
                            @foreach (BlogPostListingDto post in BlogPosts)
                            {
                                @* Report (tracker B17): signed-in viewers only; IsOwner hides it on
                                   the viewer's own post. No EditHref: group-post edits are B25. *@
                                <BlogPostCard Post="post"
                                              IsOwner="@(_currentUserId is not null && post.AuthorId == _currentUserId)"
                                              OnReport="@(_currentUserId is not null
                                                  ? EventCallback.Factory.Create<int>(this, id => _reportDialog.OpenAsync(ReportedEntityType.BlogPost, id))
                                                  : default)" />
                            }
                        </div>
                        @if (TotalBlogPosts > BlogPosts.Length)
                        {
                            <p class="text-sm text-(--color-text-muted)">Showing @BlogPosts.Length of @TotalBlogPosts posts.</p>
                        }
                    }
                </section>

                @* Comments ──────────────────────────────────────────────────────────── *@
                <section class="flex flex-col gap-3">
                    <h2 class="text-lg font-semibold text-(--color-text)">Comments</h2>
                    <CanalaveErrorBoundary Label="comments" Compact="true">
                        <CommentSection GroupId="@((int?)Group.GroupId)" CurrentUserId="_currentUserId" />
                    </CanalaveErrorBoundary>
                </section>

            </div>

            @* ── Right column: folder tree ────────────────────────────────────────── *@
            <aside class="flex flex-col gap-4">
                @if (Group.FolderTree.Count > 0 || _currentUserRole == GroupRole.Admin)
                {
                    <div class="rounded-lg border border-(--color-border) bg-(--color-surface) p-4 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <h2 class="text-base font-semibold text-(--color-text)">Folders</h2>
                            @if (_currentUserRole == GroupRole.Admin)
                            {
                                <a href="/group/@Group.GroupId/folders"
                                   class="text-xs text-(--color-action-ink) hover:underline">Manage</a>
                            }
                        </div>
                        @* The tree's per-folder unassign refusals. *@
                        <ErrorAlert Message="@_folderError" ShowSignIn="@_folderErrorIsSessionExpired" />
                        @if (Group.FolderTree.Count == 0)
                        {
                            <p class="text-xs text-(--color-text-muted)">No folders yet.</p>
                        }
                        else
                        {
                            @RenderFolders(Group.FolderTree)
                        }
                    </div>
                }
            </aside>

        </div>

    </div>
}

@code {
    [Parameter] public int GroupId { get; set; }

    /// <summary>Cosmetic catch-all segment — ignored on load; only GroupId is the key.</summary>
    [Parameter] public string? GroupSlug { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Persisted across the prerender→interactive handoff — the primary batch (group detail,
    // member stories, first page of blog posts). Public properties: [PersistentState] requires
    // them. TotalBlogPosts rides alongside BlogPosts because the service returns a ValueTuple,
    // which does not survive System.Text.Json — split into separate persisted properties
    // (layer5-wasm.md §"Avoiding the double fetch").
    [PersistentState] public GroupDetailDto? Group { get; set; }
    [PersistentState] public StoryListingDto[]? Stories { get; set; }
    [PersistentState] public BlogPostListingDto[]? BlogPosts { get; set; }
    [PersistentState] public int TotalBlogPosts { get; set; }

    // Per-viewer supplementary state — NOT persisted (StoryPage's _usiState judgment):
    // deterministic per viewer, so the interactive re-fetch is flicker-free, and it must stay
    // fresh rather than ride a stale prerender payload.
    private GroupRole? _currentUserRole;
    private int? _currentUserId;

    // Resolved from the AuthState cascade at runtime, never persisted (render mode rule): shows the
    // admin-less rescue panel (D13 edge (b)) to site moderators.
    private bool _viewerIsModerator;

    // The rescue panel's last refusal ("moved under the panel"), shown after the reload it triggered.
    // Any later load clears it (LoadGroupAsync), so it describes only the refusal just made.
    private string? _rescueRefusal;

    // Inline refusals, each beside its controls (error-handling.md: a refusal is never a toast). The
    // message and its Sign-in flag are always set together (Present, the Clear* helpers).
    private string? _membershipError;
    private bool _membershipErrorIsSessionExpired;
    private string? _storyError;
    private bool _storyErrorIsSessionExpired;
    private string? _folderError;
    private bool _folderErrorIsSessionExpired;

    // The sole admin's Leave confirm (D13's warn-on-last-admin-leave rider).
    private bool _confirmLastAdminLeaveOpen;
    private IReadOnlyDictionary<int, UserStoryInteractionStateDto> _interactionStates =
        new Dictionary<int, UserStoryInteractionStateDto>();

    private bool _isLoading = true;

    // Interstitial metadata when the group exists but the viewer hasn't consented
    // (WU-AccessGate). Deterministic per viewer — not persisted; consent forces a
    // full-document navigation.
    private GatedMetadataDto? _gate;

    // Mature count-line disclosure items for the member-story section (WU-AccessGate) —
    // per-viewer deterministic, not persisted.
    private IReadOnlyList<GatedMetadataDto> _gatedItems = [];

    private bool _initialized;
    private int _loadedGroupId = int.MinValue; // sentinel; no real GroupId equals this

    // ── Add-story state (from the former GroupDesktop composite) ─────────────────
    private ReportDialog _reportDialog = default!;
    private bool _showAddStory;

    // ── Story↔folder lookups (WU-GroupsL5b) — rebuilt from Group/Stories whenever either
    // changes (RebuildStoryLookups). Ephemeral, not persisted — pure derived view of the
    // persisted Group/Stories fields, same as _interactionStates.
    private Dictionary<int, int> _groupStoryIdByStoryId = new();
    private Dictionary<int, List<int>> _folderIdsByStoryId = new();
    private List<(int Id, string Label)> _folderOptions = [];
    private Dictionary<int, StoryListingDto> _storiesById = new();

    // Remove-from-group confirm state (admin-only trigger; two-step, mirrors
    // GroupFolderManagementPage's delete-folder pattern).
    private int? _pendingRemoveGroupStoryId;
    private string _pendingRemoveStoryTitle = string.Empty;
    private bool _confirmRemoveOpen;

    // Open Graph/Twitter meta (WU-Seo). No cover field on GroupDetailDto — falls back to the
    // site-default raster (SeoDefaults.OgFallbackImagePath; audit/Seo.md, resolved — was an SVG
    // re-use, tracker item E4).
    private string? OgDescription => Group is null ? null : SocialDescriptionHelper.Clean(Group.Description);
    private string OgImageUrl => PublicUrlProvider.AbsoluteImageUrl(null, SeoDefaults.OgFallbackImagePath);
    private string OgUrl => PublicUrlProvider.AbsolutePageUrl($"/group/{GroupId}");

    protected override async Task OnInitializedAsync()
    {
        // One-time: resolve the authenticated user id (auth doesn't change mid-session).
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            string? idStr = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            _currentUserId = int.TryParse(idStr, out int id) ? id : null;
            _viewerIsModerator = state.User.IsInRole("Moderator") || state.User.IsInRole("Admin");
        }

        if (Group is null)
        {
            // No persisted prerender value to restore (first pass) — full fresh batch. This is
            // the restore-or-fetch (??=) idiom in branch form: the page's primary content is one
            // parallel batch, so the whole batch is skipped or run together, not per-property.
            await LoadGroupAsync();
        }
        else
        {
            // [PersistentState] restored the primary batch from the prerender payload — skip the
            // DB calls it covers and refresh only the per-viewer supplementary state, which is
            // deliberately ephemeral (flicker-free re-fetch; see field comments).
            _loadedGroupId = GroupId;
            Stories ??= [];
            BlogPosts ??= [];

            _currentUserRole = await GroupService.GetCurrentUserRoleAsync(GroupId);
            if (Stories.Length > 0 && _currentUserId is not null)
            {
                IReadOnlyList<int> storyIds = Stories.Select(s => s.StoryId).ToArray();
                _interactionStates = await InteractionService.GetStatesByStoryIdsAsync(storyIds);
            }

            // Mature count-line disclosure is per-viewer ephemeral (not persisted) — without this
            // re-fetch it rendered during prerender then vanished at hydration (WU-AccessGate
            // restore-path fix, found in post-completion review).
            if (Group is not null && Group.Stories.Count > 0)
                _gatedItems = await StoryService.GetGatedCardsAsync(Group.Stories.Select(s => s.StoryId).ToList());

            RebuildStoryLookups();
            _isLoading = false;
        }

        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Fires when the same GroupPage instance is reused for a different GroupId.
        if (!_initialized) return;
        if (GroupId == _loadedGroupId) return;
        await LoadGroupAsync();
    }

    // Fresh load — plain assignments (not ??=): param-change reloads and post-write refreshes
    // must never be short-circuited by [PersistentState] values from a previous group
    // (layer3-logic.md §"Route-Parameter Dispatchers"; internal SPA navs don't prerender, so
    // there is no persisted state to restore on this path anyway).
    private async Task LoadGroupAsync()
    {
        _isLoading = true;
        _loadedGroupId = GroupId;
        _gate = null;
        _rescueRefusal = null;

        Group = await GroupService.GetByIdAsync(GroupId);

        // Gated-existence read (WU-AccessGate): an M-audience group the viewer hasn't consented
        // to → interstitial (one group consent covers all group-owned content); truly absent →
        // real 404. Child loads below are skipped either way (Group is null).
        if (Group is null)
        {
            _gate = await GroupService.GetGroupGateAsync(GroupId);
            if (_gate is null)
                Nav.NotFound();
        }

        if (Group is not null)
        {
            // Role and stories batch-loaded in parallel.
            List<int> groupStoryIds = Group.Stories.Select(s => s.StoryId).ToList();
            Task<GroupRole?> roleTask      = GroupService.GetCurrentUserRoleAsync(GroupId);
            Task<StoryListingDto[]> storyTask =
                groupStoryIds.Count > 0
                    ? StoryService.GetListingsByIdsAsync(groupStoryIds)
                    : Task.FromResult(Array.Empty<StoryListingDto>());
            // Mature count-line disclosure (WU-AccessGate): the M member stories the viewer's
            // ceiling hid — a group reveal covers group-OWNED content, member stories still gate
            // individually, so the disclosure keeps the bridge visible inside the group too.
            Task<IReadOnlyList<GatedMetadataDto>> gatedTask =
                groupStoryIds.Count > 0
                    ? StoryService.GetGatedCardsAsync(groupStoryIds)
                    : Task.FromResult<IReadOnlyList<GatedMetadataDto>>([]);
            Task<(BlogPostListingDto[], int)> blogTask =
                BlogPostService.GetByGroupAsync(GroupId, page: 1, pageSize: 10);

            await Task.WhenAll(roleTask, storyTask, gatedTask, blogTask);

            _currentUserRole = await roleTask;
            Stories          = await storyTask;
            _gatedItems      = await gatedTask;

            (BlogPostListingDto[] blogItems, int blogTotal) = await blogTask;
            BlogPosts      = blogItems;
            TotalBlogPosts = blogTotal;

            // Interaction states (no-tracking, per-viewer, nullable).
            if (Stories.Length > 0 && _currentUserId is not null)
            {
                IReadOnlyList<int> storyIds = Stories.Select(s => s.StoryId).ToArray();
                _interactionStates = await InteractionService.GetStatesByStoryIdsAsync(storyIds);
            }

            RebuildStoryLookups();
        }

        _isLoading = false;
    }

    /// <summary>
    /// The rescue panel's refusal: the group moved under it (another moderator assigned an admin, or the
    /// picked member left). Reload the group — the panel hides once it has an admin — and keep the message
    /// where the panel was (error-handling.md, the child-panel case). A failed reload is appended to the
    /// refusal, never shown instead of it.
    /// </summary>
    private async Task HandleRescueStaleAsync(string refusal)
    {
        try
        {
            await LoadGroupAsync();
            _rescueRefusal = refusal;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reloading group {GroupId} after a refused admin assignment failed", GroupId);
            _rescueRefusal = refusal + " " + ExceptionPresenter.GetUserMessage(ex);
            _isLoading = false;
        }
    }

    // ── Membership callbacks ──────────────────────────────────────────────────────

    private async Task HandleJoinAsync()
    {
        ClearMembershipError();
        try
        {
            await GroupService.JoinAsync(GroupId);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            (_membershipError, _membershipErrorIsSessionExpired) = Present(ex, "Joining");
        }
    }

    /// <summary>
    /// Leave, warned first when the viewer is the group's only admin (owner ruling D13's rider: the
    /// group would wait admin-less for a moderator). <c>LeaveAsync</c> itself is unchanged — D13 rejects
    /// auto-promotion and self-claim, so the warning is the whole remedy on this side.
    /// </summary>
    private async Task HandleLeaveClickedAsync()
    {
        if (_currentUserRole == GroupRole.Admin && Group?.AdminCount == 1)
        {
            _confirmLastAdminLeaveOpen = true;
            return;
        }
        await HandleLeaveAsync();
    }

    private async Task HandleLeaveAsync()
    {
        ClearMembershipError();
        try
        {
            await GroupService.LeaveAsync(GroupId);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            (_membershipError, _membershipErrorIsSessionExpired) = Present(ex, "Leaving");
        }
    }

    // ── Add-story UI (from the former GroupDesktop composite) ─────────────────────

    private void ToggleAddStory() => _showAddStory = !_showAddStory;

    private async Task HandleAddStoryAsync(StoryTitleSearchDto story)
    {
        await HandleStoryAddedAsync(new AddGroupStoryDto
        {
            GroupId = Group!.GroupId,
            StoryId = story.StoryId
        });
        _showAddStory = false;
    }

    // ── Folder tree (recursive render — Razor template, not RenderTreeBuilder: this method
    // gained real interactive children (the per-story unassign button) — the declarative
    // template form is far less error-prone for that than hand-sequencing OpenElement/
    // AddAttribute calls. Same idiom as GroupFolderManagementPage.RenderFolderTree. ──────────

    private RenderFragment RenderFolders(IReadOnlyList<GroupFolderDto> folders) =>
        @<ul class="flex flex-col gap-1 text-sm">
            @foreach (GroupFolderDto folder in folders)
            {
                <li class="flex flex-col gap-1">
                    <div class="flex items-center gap-1 text-(--color-text)">
                        <span>📁 @folder.Name</span>
                        @* Deliberate zero-trace: an M-capped folder inside an E-audience
                           (Standard) group renders as an unlabeled folder to mature-off viewers —
                           suppressing the "(M)" badge rather than advertising a mature shelf
                           (2026-07-19). *@
                        @if (folder.MaxRating != Rating.M)
                        {
                            <span class="text-xs text-(--color-text-muted)">(@folder.MaxRating)</span>
                        }
                    </div>
                    @* Folder contents — visible to EVERY viewer (never gated; only the
                       write actions below are admin-only, WU32 RequireAdminAsync). *@
                    @if (folder.Stories.Count > 0)
                    {
                        <ul class="ml-5 flex flex-col gap-0.5">
                            @foreach (GroupStoryDto groupStory in folder.Stories)
                            {
                                if (_storiesById.TryGetValue(groupStory.StoryId, out StoryListingDto? story))
                                {
                                    <li class="flex items-center justify-between gap-1 text-xs">
                                        <a href="/story/@story.StoryId"
                                           class="truncate text-(--color-action-ink) hover:underline">@story.Title</a>
                                        @if (_currentUserRole == GroupRole.Admin)
                                        {
                                            <button type="button"
                                                    aria-label="@($"Remove {story.Title} from {folder.Name}")"
                                                    class="shrink-0 text-(--color-danger) hover:underline"
                                                    @onclick="() => HandleUnassignAsync(groupStory.GroupStoryId, folder.GroupFolderId)">
                                                &times;
                                            </button>
                                        }
                                    </li>
                                }
                            }
                        </ul>
                    }
                    @if (folder.Children.Count > 0)
                    {
                        <div class="ml-4">
                            @RenderFolders(folder.Children)
                        </div>
                    }
                </li>
            }
        </ul>;

    // ── Story↔folder lookups + admin write actions (WU-GroupsL5b) ────────────────────

    /// <summary>
    /// Rebuilds every derived story↔folder lookup from Group/Stories — call after either changes
    /// (both OnInitializedAsync's restore branch and the end of LoadGroupAsync). Pure view, not
    /// persisted; cheap (group-scale collections).
    /// </summary>
    private void RebuildStoryLookups()
    {
        _groupStoryIdByStoryId = Group?.Stories.ToDictionary(s => s.StoryId, s => s.GroupStoryId)
            ?? new Dictionary<int, int>();
        _storiesById = (Stories ?? []).ToDictionary(s => s.StoryId);

        _folderIdsByStoryId = new Dictionary<int, List<int>>();
        _folderOptions = [];
        if (Group is not null)
        {
            CollectFolderMembership(Group.FolderTree);
            FlattenFoldersForSelect(Group.FolderTree, depth: 0);
        }
    }

    private void CollectFolderMembership(IReadOnlyList<GroupFolderDto> folders)
    {
        foreach (GroupFolderDto folder in folders)
        {
            foreach (GroupStoryDto groupStory in folder.Stories)
            {
                if (!_folderIdsByStoryId.TryGetValue(groupStory.StoryId, out List<int>? list))
                    _folderIdsByStoryId[groupStory.StoryId] = list = [];
                list.Add(folder.GroupFolderId);
            }
            CollectFolderMembership(folder.Children);
        }
    }

    private void FlattenFoldersForSelect(IReadOnlyList<GroupFolderDto> folders, int depth)
    {
        foreach (GroupFolderDto folder in folders)
        {
            _folderOptions.Add((folder.GroupFolderId, new string('—', depth) + " " + folder.Name));
            FlattenFoldersForSelect(folder.Children, depth + 1);
        }
    }

    /// <summary>
    /// Per-story admin overlay (StoryDeck's CardOverlay slot — a folder-move select + a
    /// remove-from-group trigger). Null for non-admins, preserving every other viewer's rendering
    /// exactly (StoryDeck's own "additive only" contract on that slot).
    /// </summary>
    private RenderFragment<StoryListingDto>? AdminStoryOverlay =>
        _currentUserRole != GroupRole.Admin ? null : story =>
            @<div class="pointer-events-auto flex flex-col gap-1 rounded-md border border-(--color-border) bg-(--color-surface-raised) p-1.5 text-xs shadow-medium">
                @{
                    int groupStoryId = _groupStoryIdByStoryId.GetValueOrDefault(story.StoryId);
                    List<int> currentFolders = _folderIdsByStoryId.GetValueOrDefault(story.StoryId) ?? [];
                }
                @if (currentFolders.Count <= 1)
                {
                    <select aria-label="@($"Move {story.Title} to folder")"
                            class="rounded border border-(--color-border) bg-(--color-surface) px-1 py-0.5 text-xs text-(--color-text)"
                            @onchange="@(e => HandleFolderAssignmentChangedAsync(groupStoryId, currentFolders, ParseFolderSelectValue(e.Value)))">
                        <option value="" selected="@(currentFolders.Count == 0)">(unfiled)</option>
                        @foreach ((int id, string label) in _folderOptions)
                        {
                            <option value="@id" selected="@(currentFolders.Contains(id))">@label</option>
                        }
                    </select>
                }
                else
                {
                    @* Genuinely-possible edge case (GroupStory.GroupFolders is a many-to-many at
                       the data layer) — don't have the dropdown silently guess which one "wins";
                       point at the per-folder × controls in the tree to resolve it explicitly. *@
                    <span class="text-(--color-text-muted)">In @currentFolders.Count folders &mdash; use the folder list to remove one</span>
                }
                <button type="button" class="text-left text-(--color-danger) hover:underline"
                        @onclick="() => BeginRemoveStory(groupStoryId, story.Title)">
                    Remove from group
                </button>
            </div>;

    private static int? ParseFolderSelectValue(object? value) =>
        value is string s && int.TryParse(s, out int id) ? id : null;

    /// <summary>
    /// Reconciles a story's folder membership toward <paramref name="newFolderId"/> (null =
    /// unfiled) from its <paramref name="currentFolderIds"/> — only ever called with 0 or 1
    /// current folders (see the &gt;1 branch in <see cref="AdminStoryOverlay"/>, which never
    /// offers this control).
    /// </summary>
    private async Task HandleFolderAssignmentChangedAsync(
        int groupStoryId, IReadOnlyList<int> currentFolderIds, int? newFolderId)
    {
        ClearStoryError();
        try
        {
            foreach (int oldFolderId in currentFolderIds)
            {
                if (oldFolderId != newFolderId)
                    await GroupService.UnassignStoryFromFolderAsync(groupStoryId, oldFolderId);
            }
            if (newFolderId is int folderId && !currentFolderIds.Contains(folderId))
                await GroupService.AssignStoryToFolderAsync(groupStoryId, folderId);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            // ContentRatingExceededException (a folder's rating cap) is user-facing like the rest.
            (_storyError, _storyErrorIsSessionExpired) = Present(ex, "Filing a story");
        }
    }

    /// <summary>Per-folder × control in the tree — unassigns from exactly that one folder.</summary>
    private async Task HandleUnassignAsync(int groupStoryId, int groupFolderId)
    {
        _folderError = null;
        _folderErrorIsSessionExpired = false;
        try
        {
            await GroupService.UnassignStoryFromFolderAsync(groupStoryId, groupFolderId);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            (_folderError, _folderErrorIsSessionExpired) = Present(ex, "Unfiling a story");
        }
    }

    private void BeginRemoveStory(int groupStoryId, string storyTitle)
    {
        _pendingRemoveGroupStoryId = groupStoryId;
        _pendingRemoveStoryTitle = storyTitle;
        _confirmRemoveOpen = true;
    }

    /// <summary>ConfirmDialog's OnConfirm — delegates to the already-implemented, previously
    /// unwired HandleStoryRemovedAsync (no change needed to that handler itself).</summary>
    private async Task HandleRemoveConfirmedAsync()
    {
        if (_pendingRemoveGroupStoryId is int groupStoryId)
            await HandleStoryRemovedAsync(groupStoryId);
        _pendingRemoveGroupStoryId = null;
        _pendingRemoveStoryTitle = string.Empty;
    }

    // ── Story management callbacks ────────────────────────────────────────────────

    private async Task HandleStoryAddedAsync(AddGroupStoryDto dto)
    {
        ClearStoryError();
        try
        {
            await GroupService.AddStoryAsync(dto);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            // ContentRatingExceededException (the group's rating cap) is user-facing like the rest.
            (_storyError, _storyErrorIsSessionExpired) = Present(ex, "Adding a story");
        }
    }

    private async Task HandleStoryRemovedAsync(int groupStoryId)
    {
        ClearStoryError();
        try
        {
            await GroupService.RemoveStoryAsync(groupStoryId);
            await LoadGroupAsync();
        }
        catch (Exception ex)
        {
            (_storyError, _storyErrorIsSessionExpired) = Present(ex, "Removing a story");
        }
    }

    // -- Inline refusals (the WU-ErrorHandling2 follow-up, WU-TrackerFixes 2026-10-13) --------------

    private void ClearMembershipError()
    {
        _membershipError = null;
        _membershipErrorIsSessionExpired = false;
    }

    private void ClearStoryError()
    {
        _storyError = null;
        _storyErrorIsSessionExpired = false;
    }

    /// <summary>
    /// The message and its Sign-in flag for a refused operation, set together. A failure that is not
    /// user-facing logs at Error and shows the generic message with its trace id (error-handling.md).
    /// </summary>
    private (string Message, bool IsSessionExpired) Present(Exception ex, string operation)
    {
        if (!ExceptionPresenter.IsUserFacing(ex))
            Logger.LogError(ex, "{Operation} failed unexpectedly in group {GroupId}", operation, GroupId);
        return (ExceptionPresenter.GetUserMessage(ex), ex is SessionExpiredException);
    }
}
