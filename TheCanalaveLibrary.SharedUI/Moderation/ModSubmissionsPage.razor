@page "/mod/submissions"
@namespace TheCanalaveLibrary.SharedUI
@attribute [Authorize(Roles = "Moderator,Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@inject ILogger<ModSubmissionsPage> Logger
@inject IModerationWriteService ModerationService
@inject IExternalVerificationWriteService ExternalVerificationService

@* Story submission queue (WU34 Feature 48) + external-link verification (Feature 53, WU39).
   Tabbed shell — Stories tab is the active tab. Desktop-only.

   Stories tab — Approve: sets StoryStatusId = PostApprovalStatus + fires StoryApproved
   notification. Reject: sets StoryStatusId = Rejected + records reason + fires StoryRejected
   notification.

   Imports tab — two independent queues, both manual review (no server-side fetch, ever):
   account tier (open the profile URL, confirm the code text is present) and per-link tier (open
   the linked story, confirm its listed author matches the confirmed account handle). Approve/
   reject on either fires the matching notification; a rejected link is NOT hidden publicly
   (settled 2026-07-24, audit/Moderation.md F53 — hiding reads as an accusation).

   [PersistentState] on all three queues avoids the prerender→interactive double fetch; persisted
   payload = rendered content, mod-gated page (layer5-wasm.md §"Avoiding the double fetch"). *@

<PageTitle>Mod — Submissions</PageTitle>

<div class="flex flex-col gap-4 px-4 py-4">

    <h1 class="text-xl font-bold text-text">Submissions</h1>

    @* ── Tab bar ─────────────────────────────────────────────────────────────── *@
    <nav class="flex gap-1 border-b border-(--color-border) pb-0" aria-label="Submission tabs">
        <button type="button"
                class="@TabClasses(_tab == SubmissionTab.Stories)"
                @onclick="() => _tab = SubmissionTab.Stories">
            Stories
        </button>
        <button type="button"
                class="@TabClasses(_tab == SubmissionTab.Imports)"
                @onclick="() => _tab = SubmissionTab.Imports">
            Imports
        </button>
    </nav>

    @if (_tab == SubmissionTab.Stories)
    {
        @* ── Stories tab ─────────────────────────────────────────────────────── *@
        @if (_loading || Submissions is null)
        {
            <p class="text-sm text-(--color-text-muted)">Loading…</p>
        }
        else if (Submissions.Length == 0)
        {
            <p class="text-sm text-(--color-text-muted)">No pending submissions.</p>
        }
        else
        {
            <div class="flex flex-col gap-3">
                @foreach (var s in Submissions)
                {
                    var sub = s;
                    <div class="rounded-lg border border-(--color-border) bg-surface p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <a href="/story/@sub.StoryId" target="_blank"
                                   class="font-semibold text-(--color-action-ink) hover:underline">
                                    @sub.Title
                                </a>
                                <p class="mt-0.5 text-sm text-(--color-text-muted)">
                                    by @sub.AuthorUserName &mdash;
                                    @sub.Rating &mdash;
                                    submitted @sub.SubmittedDate.ToString("yyyy-MM-dd")
                                    @if (sub.IsImportedWork) { <span class="ml-1 rounded bg-warning/20 px-1 py-0.5 text-xs text-warning">Import</span> }
                                </p>
                                <p class="mt-1 text-xs text-(--color-text-muted)">
                                    Approve → publishes as <strong>@sub.PostApprovalStatus</strong>
                                </p>
                            </div>
                            <div class="flex shrink-0 flex-col items-end gap-2">
                                <button type="button"
                                        class="rounded-md bg-(--color-success)/15 px-3 py-1 text-sm text-(--color-success) ring-1 ring-(--color-success)/30 transition-colors hover:bg-(--color-success)/25 disabled:opacity-50"
                                        disabled="@(_actingStoryId is not null)"
                                        @onclick="() => ApproveAsync(sub.StoryId)">
                                    Approve
                                </button>
                                <button type="button"
                                        class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                        disabled="@(_actingStoryId is not null)"
                                        @onclick="() => OpenRejectPanel(sub)">
                                    Reject
                                </button>
                            </div>
                        </div>

                        @* ── Inline reject reason panel ───────────────────────── *@
                        @if (_rejectingStoryId == sub.StoryId)
                        {
                            <div class="mt-3 border-t border-(--color-border) pt-3">
                                <label class="mb-1 block text-sm font-medium text-text" for="reject-reason-@sub.StoryId">
                                    Rejection reason
                                </label>
                                <textarea id="reject-reason-@sub.StoryId" rows="2"
                                          class="w-full rounded-md border border-(--color-border) bg-surface px-3 py-2 text-sm text-text"
                                          @bind="_rejectReason"></textarea>
                                @if (_rejectError is not null)
                                {
                                    <div class="mt-1"><InlineAlert Message="@_rejectError" /></div>
                                }
                                <div class="mt-2 flex gap-2">
                                    <button type="button"
                                            class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                            disabled="@(_actingStoryId is not null)"
                                            @onclick="() => ConfirmRejectAsync(sub.StoryId)">
                                        Confirm reject
                                    </button>
                                    <button type="button"
                                            class="rounded border border-(--color-border) bg-surface px-3 py-1 text-sm text-text"
                                            @onclick="CancelReject">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        @* ── Imports tab — external-link verification (Feature 53, WU39) ─────────── *@
        <div class="flex flex-col gap-6">
            <section class="flex flex-col gap-3">
                <h2 class="text-lg font-semibold text-text">Pending account verifications</h2>
                <p class="text-xs text-(--color-text-muted)">
                    Open the profile URL and confirm the code text is present, then approve or reject.
                </p>
                @if (_accountsLoading || PendingAccounts is null)
                {
                    <p class="text-sm text-(--color-text-muted)">Loading…</p>
                }
                else if (PendingAccounts.Length == 0)
                {
                    <p class="text-sm text-(--color-text-muted)">No pending account verifications.</p>
                }
                else
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var a in PendingAccounts)
                        {
                            var acc = a;
                            <div class="rounded-lg border border-(--color-border) bg-surface p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="font-semibold text-text">@acc.UserName &mdash; @acc.PlatformName</p>
                                        <p class="mt-0.5 text-sm text-(--color-text-muted)">
                                            Handle: @acc.Handle &mdash;
                                            requested @acc.DateRequested.ToString("yyyy-MM-dd")
                                        </p>
                                        <p class="mt-1 text-xs text-(--color-text-muted)">
                                            Look for code
                                            <code class="rounded border border-(--color-border) bg-(--color-surface-raised) px-1 py-0.5">@acc.VerificationCode</code>
                                            on <a href="@acc.ProfileUrl" target="_blank" rel="noopener noreferrer nofollow"
                                                  class="text-(--color-action-ink) hover:underline">their profile ↗</a>
                                        </p>
                                    </div>
                                    <div class="flex shrink-0 flex-col items-end gap-2">
                                        <button type="button"
                                                class="rounded-md bg-(--color-success)/15 px-3 py-1 text-sm text-(--color-success) ring-1 ring-(--color-success)/30 transition-colors hover:bg-(--color-success)/25 disabled:opacity-50"
                                                disabled="@(_actingAccountId is not null)"
                                                @onclick="() => ApproveAccountAsync(acc.UserExternalIdentityId)">
                                            Approve
                                        </button>
                                        <button type="button"
                                                class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                                disabled="@(_actingAccountId is not null)"
                                                @onclick="() => OpenRejectAccountPanel(acc.UserExternalIdentityId)">
                                            Reject
                                        </button>
                                    </div>
                                </div>

                                @if (_rejectingAccountId == acc.UserExternalIdentityId)
                                {
                                    <div class="mt-3 border-t border-(--color-border) pt-3">
                                        <label class="mb-1 block text-sm font-medium text-text" for="reject-account-reason-@acc.UserExternalIdentityId">
                                            Rejection reason
                                        </label>
                                        <textarea id="reject-account-reason-@acc.UserExternalIdentityId" rows="2"
                                                  class="w-full rounded-md border border-(--color-border) bg-surface px-3 py-2 text-sm text-text"
                                                  @bind="_rejectAccountReason"></textarea>
                                        @if (_rejectAccountError is not null)
                                        {
                                            <div class="mt-1"><InlineAlert Message="@_rejectAccountError" /></div>
                                        }
                                        <div class="mt-2 flex gap-2">
                                            <button type="button"
                                                    class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                                    disabled="@(_actingAccountId is not null)"
                                                    @onclick="() => ConfirmRejectAccountAsync(acc.UserExternalIdentityId)">
                                                Confirm reject
                                            </button>
                                            <button type="button"
                                                    class="rounded border border-(--color-border) bg-surface px-3 py-1 text-sm text-text"
                                                    @onclick="CancelRejectAccount">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="flex flex-col gap-3">
                <h2 class="text-lg font-semibold text-text">Pending link verifications</h2>
                <p class="text-xs text-(--color-text-muted)">
                    Open the linked story and confirm its listed author matches the confirmed account handle, then approve or reject.
                </p>
                @if (_linksLoading || PendingLinks is null)
                {
                    <p class="text-sm text-(--color-text-muted)">Loading…</p>
                }
                else if (PendingLinks.Length == 0)
                {
                    <p class="text-sm text-(--color-text-muted)">No pending link verifications.</p>
                }
                else
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var l in PendingLinks)
                        {
                            var link = l;
                            <div class="rounded-lg border border-(--color-border) bg-surface p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <a href="@link.StoryUrl" target="_blank"
                                           class="font-semibold text-(--color-action-ink) hover:underline">
                                            @link.StoryTitle
                                        </a>
                                        <p class="mt-0.5 text-sm text-(--color-text-muted)">
                                            by @link.AuthorUserName &mdash; @link.PlatformName &mdash;
                                            requested @link.DateRequested.ToString("yyyy-MM-dd")
                                        </p>
                                        <p class="mt-1 text-xs text-(--color-text-muted)">
                                            Confirmed account: @link.AccountHandle &mdash;
                                            <a href="@link.LinkUrl" target="_blank" rel="noopener noreferrer nofollow"
                                               class="text-(--color-action-ink) hover:underline">open link ↗</a>
                                        </p>
                                    </div>
                                    <div class="flex shrink-0 flex-col items-end gap-2">
                                        <button type="button"
                                                class="rounded-md bg-(--color-success)/15 px-3 py-1 text-sm text-(--color-success) ring-1 ring-(--color-success)/30 transition-colors hover:bg-(--color-success)/25 disabled:opacity-50"
                                                disabled="@(_actingLinkId is not null)"
                                                @onclick="() => ApproveLinkAsync(link.StoryExternalLinkId)">
                                            Approve
                                        </button>
                                        <button type="button"
                                                class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                                disabled="@(_actingLinkId is not null)"
                                                @onclick="() => OpenRejectLinkPanel(link.StoryExternalLinkId)">
                                            Reject
                                        </button>
                                    </div>
                                </div>

                                @if (_rejectingLinkId == link.StoryExternalLinkId)
                                {
                                    <div class="mt-3 border-t border-(--color-border) pt-3">
                                        <label class="mb-1 block text-sm font-medium text-text" for="reject-link-reason-@link.StoryExternalLinkId">
                                            Rejection reason
                                        </label>
                                        <textarea id="reject-link-reason-@link.StoryExternalLinkId" rows="2"
                                                  class="w-full rounded-md border border-(--color-border) bg-surface px-3 py-2 text-sm text-text"
                                                  @bind="_rejectLinkReason"></textarea>
                                        @if (_rejectLinkError is not null)
                                        {
                                            <div class="mt-1"><InlineAlert Message="@_rejectLinkError" /></div>
                                        }
                                        <div class="mt-2 flex gap-2">
                                            <button type="button"
                                                    class="rounded-md bg-danger px-3 py-1 text-sm text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50"
                                                    disabled="@(_actingLinkId is not null)"
                                                    @onclick="() => ConfirmRejectLinkAsync(link.StoryExternalLinkId)">
                                                Confirm reject
                                            </button>
                                            <button type="button"
                                                    class="rounded border border-(--color-border) bg-surface px-3 py-1 text-sm text-text"
                                                    @onclick="CancelRejectLink">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private enum SubmissionTab { Stories, Imports }

    private SubmissionTab _tab = SubmissionTab.Stories;

    // Persisted across the prerender→interactive handoff — restored via ??= in OnInitializedAsync.
    // Post-approve/reject refetches go through LoadAsync (plain assignment).
    [PersistentState]
    public StorySubmissionQueueItemDto[]? Submissions { get; set; }

    private bool _loading = true;

    private int? _actingStoryId;
    private int? _rejectingStoryId;
    private string? _rejectReason;
    private string? _rejectError;

    // ── Imports tab state (Feature 53, WU39) — two independent queues ────────────
    [PersistentState]
    public PendingAccountVerificationDto[]? PendingAccounts { get; set; }
    [PersistentState]
    public PendingLinkVerificationDto[]? PendingLinks { get; set; }

    private bool _accountsLoading = true;
    private bool _linksLoading = true;

    private int? _actingAccountId;
    private int? _rejectingAccountId;
    private string? _rejectAccountReason;
    private string? _rejectAccountError;

    private int? _actingLinkId;
    private int? _rejectingLinkId;
    private string? _rejectLinkReason;
    private string? _rejectLinkError;

    protected override async Task OnInitializedAsync()
    {
        // ??= — skip the fetch when [PersistentState] restored the prerendered queue.
        Submissions ??= await ModerationService.GetPendingSubmissionsAsync();
        _loading = false;

        PendingAccounts ??= (await ExternalVerificationService.GetPendingAccountVerificationsAsync()).ToArray();
        _accountsLoading = false;
        PendingLinks ??= (await ExternalVerificationService.GetPendingLinkVerificationsAsync()).ToArray();
        _linksLoading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        Submissions = await ModerationService.GetPendingSubmissionsAsync();
        _loading = false;
    }

    private async Task ApproveAsync(int storyId)
    {
        _actingStoryId = storyId;
        _rejectError = null;
        try
        {
            await ModerationService.ApproveStoryAsync(storyId);
            await LoadAsync();
        }
        catch (Exception ex) { _rejectError = Translate(ex, "Approving a story submission failed unexpectedly"); }
        finally { _actingStoryId = null; }
    }

    private void OpenRejectPanel(StorySubmissionQueueItemDto sub)
    {
        _rejectingStoryId = sub.StoryId;
        _rejectReason = null;
        _rejectError = null;
    }

    private void CancelReject()
    {
        _rejectingStoryId = null;
        _rejectReason = null;
        _rejectError = null;
    }

    private async Task ConfirmRejectAsync(int storyId)
    {
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            _rejectError = "A rejection reason is required.";
            return;
        }

        _actingStoryId = storyId;
        _rejectError = null;
        try
        {
            await ModerationService.RejectStoryAsync(storyId, _rejectReason!);
            CancelReject();
            await LoadAsync();
        }
        catch (Exception ex) { _rejectError = Translate(ex, "Rejecting a story submission failed unexpectedly"); }
        finally { _actingStoryId = null; }
    }

    // ── Imports tab — account tier (WU39) ─────────────────────────────────────────

    private async Task LoadAccountsAsync()
    {
        _accountsLoading = true;
        PendingAccounts = (await ExternalVerificationService.GetPendingAccountVerificationsAsync()).ToArray();
        _accountsLoading = false;
    }

    private async Task ApproveAccountAsync(int userExternalIdentityId)
    {
        _actingAccountId = userExternalIdentityId;
        _rejectAccountError = null;
        try
        {
            await ExternalVerificationService.ApproveAccountVerificationAsync(userExternalIdentityId);
            await LoadAccountsAsync();
        }
        catch (Exception ex) { _rejectAccountError = Translate(ex, "Approving an account verification failed unexpectedly"); }
        finally { _actingAccountId = null; }
    }

    private void OpenRejectAccountPanel(int userExternalIdentityId)
    {
        _rejectingAccountId = userExternalIdentityId;
        _rejectAccountReason = null;
        _rejectAccountError = null;
    }

    private void CancelRejectAccount()
    {
        _rejectingAccountId = null;
        _rejectAccountReason = null;
        _rejectAccountError = null;
    }

    private async Task ConfirmRejectAccountAsync(int userExternalIdentityId)
    {
        if (string.IsNullOrWhiteSpace(_rejectAccountReason))
        {
            _rejectAccountError = "A rejection reason is required.";
            return;
        }

        _actingAccountId = userExternalIdentityId;
        _rejectAccountError = null;
        try
        {
            await ExternalVerificationService.RejectAccountVerificationAsync(userExternalIdentityId, _rejectAccountReason!);
            CancelRejectAccount();
            await LoadAccountsAsync();
        }
        catch (Exception ex) { _rejectAccountError = Translate(ex, "Rejecting an account verification failed unexpectedly"); }
        finally { _actingAccountId = null; }
    }

    // ── Imports tab — per-link tier (WU39) ────────────────────────────────────────

    private async Task LoadLinksAsync()
    {
        _linksLoading = true;
        PendingLinks = (await ExternalVerificationService.GetPendingLinkVerificationsAsync()).ToArray();
        _linksLoading = false;
    }

    private async Task ApproveLinkAsync(int storyExternalLinkId)
    {
        _actingLinkId = storyExternalLinkId;
        _rejectLinkError = null;
        try
        {
            await ExternalVerificationService.ApproveLinkVerificationAsync(storyExternalLinkId);
            await LoadLinksAsync();
        }
        catch (Exception ex) { _rejectLinkError = Translate(ex, "Approving a link verification failed unexpectedly"); }
        finally { _actingLinkId = null; }
    }

    private void OpenRejectLinkPanel(int storyExternalLinkId)
    {
        _rejectingLinkId = storyExternalLinkId;
        _rejectLinkReason = null;
        _rejectLinkError = null;
    }

    private void CancelRejectLink()
    {
        _rejectingLinkId = null;
        _rejectLinkReason = null;
        _rejectLinkError = null;
    }

    private async Task ConfirmRejectLinkAsync(int storyExternalLinkId)
    {
        if (string.IsNullOrWhiteSpace(_rejectLinkReason))
        {
            _rejectLinkError = "A rejection reason is required.";
            return;
        }

        _actingLinkId = storyExternalLinkId;
        _rejectLinkError = null;
        try
        {
            await ExternalVerificationService.RejectLinkVerificationAsync(storyExternalLinkId, _rejectLinkReason!);
            CancelRejectLink();
            await LoadLinksAsync();
        }
        catch (Exception ex) { _rejectLinkError = Translate(ex, "Rejecting a link verification failed unexpectedly"); }
        finally { _actingLinkId = null; }
    }

    /// <summary>Catch-site exception-message discipline (mirrors CommentSection.Translate).</summary>
    private string Translate(Exception ex, string unexpectedTemplate)
    {
        if (!ExceptionPresenter.IsUserFacing(ex))
        {
#pragma warning disable CA2254 // template is one of a fixed set of literals passed by callers
            Logger.LogError(ex, unexpectedTemplate);
#pragma warning restore CA2254
        }
        return ExceptionPresenter.GetUserMessage(ex);
    }

    private static string TabClasses(bool isActive) =>
        "px-4 py-2 text-sm font-medium transition-colors border-b-2 " + (isActive
            ? "border-(--color-action-ink) text-(--color-action-ink)"
            : "border-transparent text-(--color-text-muted) hover:text-text hover:border-(--color-border)");
}
