@namespace TheCanalaveLibrary.SharedUI

@* The author story delete's confirm dialog (owner ruling D15, WU-AuthorStoryDelete 2026-10-13) — rendered
   by StoryEditorPage in edit mode. Presentational: no @inject; the page owns the DeleteStoryAsync and
   unpublish calls, the busy flag and the error list, and passes them in.

   Built directly on Modal, not ConfirmDialog (layer3.5-structure.md "A confirm that needs more than
   Confirm/Cancel"): it needs a typed-title input, a delete button that stays disabled until the input
   matches, and two outs offered first. In order: the irreversibility copy naming what goes with the
   story (D15: comments, recommendations, readers' progress); "Before you delete" — Unpublish instead
   (published stories only; D1's reversible published → Draft) and a download of the story
   (StoryDownloadLinks: plain anchors, which bypass the circuit — and they export published chapters
   only, which the copy says; roadmap.md decision row 27 (d)); the labelled title input; then the
   footer, Cancel before the filled-danger delete. For a taken-down story (IsTakenDown) neither out works,
   so one line says so in their place.

   The match is ordinal and case-sensitive, with whitespace runs collapsed on both sides (the label shows
   the title in normal flow, which collapses them too), against StoryTitle — the SAVED title the page
   captured at load, never the live form value. The typed text clears whenever the dialog opens. A
   backdrop click is a Cancel (the ConfirmDialog rule), ignored while a call is in flight. *@

<Modal IsOpen="IsOpen" IsOpenChanged="HandleModalIsOpenChanged"
       Title="Delete this story permanently?" PanelClass="max-w-lg max-h-full overflow-y-auto">
    <ChildContent>
        <div class="flex flex-col gap-4 text-sm text-(--color-text)">
            <p data-testid="story-delete-warning">
                <strong>@StoryTitle</strong> will be deleted for good. This can't be undone, and there is no way to
                restore it.
            </p>
            <p>
                Everything that belongs to it goes with it: its chapters, every comment and reply on them, readers'
                recommendations of it, readers' reading progress, favorites and bookshelf entries, and its places in
                series, custom lists, groups and story lineage.
            </p>

            <section class="flex flex-col gap-2 rounded-md border border-(--color-border) bg-(--color-surface) p-3"
                     aria-labelledby="story-delete-outs-heading">
                <h3 id="story-delete-outs-heading" class="font-semibold">Before you delete</h3>
                @if (IsTakenDown)
                {
                    <p class="text-(--color-text-muted)" data-testid="story-delete-taken-down">
                        A moderator has taken this story down, so it can't be unpublished or downloaded first.
                    </p>
                }
                else
                {
                    if (CanUnpublish)
                    {
                        <p class="text-(--color-text-muted)">
                            Unpublishing hides the story from readers and keeps everything. You can publish it again
                            later, though it may need a moderator's review first.
                        </p>
                        <button type="button"
                                class="self-start rounded-md bg-(--color-action) px-3 py-1.5 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-action-hover) disabled:opacity-50 disabled:cursor-not-allowed"
                                aria-label="Unpublish this story instead of deleting it"
                                disabled="@IsBusy"
                                @onclick="UnpublishAsync">
                            Unpublish instead
                        </button>
                    }
                    <p class="text-(--color-text-muted)">
                        Keep a copy first. Downloads include only the chapters that are published.
                    </p>
                    <StoryDownloadLinks StoryId="StoryId" />
                }
            </section>

            <div class="flex flex-col gap-1">
                <label for="story-delete-confirm" class="font-semibold">
                    To confirm, type the story's title: <span class="font-normal">@StoryTitle</span>
                </label>
                <input id="story-delete-confirm" type="text" autocomplete="off"
                       class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 text-sm text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)"
                       value="@_typed"
                       @oninput="OnTyped"
                       disabled="@IsBusy" />
            </div>

            <ErrorAlert Messages="ErrorMessages" ShowSignIn="ShowSignIn" />
        </div>
    </ChildContent>
    <Footer>
        <button type="button"
                class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-1.5 text-sm text-(--color-text) transition-colors hover:bg-(--color-surface-hover) disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Cancel and keep the story"
                disabled="@IsBusy"
                @onclick="CancelAsync">
            Cancel
        </button>
        <button type="button"
                class="rounded-md bg-(--color-danger) px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-(--color-danger-strong) disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Delete story permanently"
                disabled="@(!CanConfirm)"
                @onclick="ConfirmAsync">
            @(IsBusy ? "Deleting…" : "Delete story permanently")
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>The story the download links export.</summary>
    [Parameter, EditorRequired] public int StoryId { get; set; }

    /// <summary>The story's SAVED title — the confirmation string. Never the form's live value.</summary>
    [Parameter, EditorRequired] public string StoryTitle { get; set; } = "";

    /// <summary>True while the story is in the published set — shows the Unpublish-instead out.</summary>
    [Parameter] public bool CanUnpublish { get; set; }

    /// <summary>A moderator has taken the story down: neither out works (its status is frozen and its
    /// export 404s), so both are replaced by a line saying so. The delete itself is unchanged (D15).</summary>
    [Parameter] public bool IsTakenDown { get; set; }

    /// <summary>True while the page has a write in flight — disables every control.</summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary>The page's last failure, shown inside the dialog (it covers the page).</summary>
    [Parameter] public IReadOnlyList<string>? ErrorMessages { get; set; }

    /// <summary>The failure was a <c>SessionExpiredException</c> — ErrorAlert adds Sign in.</summary>
    [Parameter] public bool ShowSignIn { get; set; }

    [Parameter] public EventCallback OnConfirmDelete { get; set; }

    [Parameter] public EventCallback OnUnpublish { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private string _typed = "";
    private bool _wasOpen;

    /// <summary>Exact, ordinal (case-sensitive) match — a spec choice; D15 asks only for a typed title —
    /// after collapsing whitespace on both sides. The title shows in normal HTML flow, which renders any
    /// run of whitespace (a double space, a tab, a non-breaking space) as one space, and titles are stored
    /// as typed; so the author types what they see (WU-AuthorStoryDelete review fixes, 2026-10-13).</summary>
    private bool TitleMatches
    {
        get
        {
            string expected = CollapseWhitespace(StoryTitle);
            return expected.Length > 0 && string.Equals(CollapseWhitespace(_typed), expected, StringComparison.Ordinal);
        }
    }

    /// <summary>Trims, and turns every run of whitespace (<see cref="char.IsWhiteSpace(char)"/>, which
    /// includes the non-breaking space) into one ordinary space.</summary>
    private static string CollapseWhitespace(string text) =>
        string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private bool CanConfirm => TitleMatches && !IsBusy;

    protected override void OnParametersSet()
    {
        // A fresh confirmation every time the dialog opens.
        if (IsOpen && !_wasOpen) _typed = "";
        _wasOpen = IsOpen;
    }

    private void OnTyped(ChangeEventArgs e) => _typed = e.Value?.ToString() ?? "";

    private async Task ConfirmAsync()
    {
        // The button is disabled unless this holds; re-checked for a click that beat the re-render.
        if (!CanConfirm) return;
        await OnConfirmDelete.InvokeAsync();
    }

    private async Task UnpublishAsync()
    {
        if (IsBusy || !CanUnpublish || IsTakenDown) return;
        await OnUnpublish.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        if (IsBusy) return;
        await OnCancel.InvokeAsync();
        await IsOpenChanged.InvokeAsync(false);
    }

    /// <summary>Modal's only closing action is a backdrop click: treat it as Cancel, and ignore it while a
    /// call is in flight (the page still owns the open state).</summary>
    private async Task HandleModalIsOpenChanged(bool value)
    {
        if (!value && IsOpen) await CancelAsync();
    }
}
