@namespace TheCanalaveLibrary.SharedUI
@using TheCanalaveLibrary.Core
@using Microsoft.AspNetCore.Components.Forms

@* Presentational form for story create/edit. No @inject — all I/O lives in StoryEditorPage.
   Contract:
     - ViewModel carries field values + structured tag state + validation errors (set by the page).
     - OnValidSubmit fires when EditForm validation passes; the page then calls GetLongDescriptionAsync()
       and reads SelectedCoverFile before mapping to the write DTO.
     - InitialTagsByType seeds TagSelectors on first render (edit mode). Null = create mode (empty).
     - InitialCharacters/SettingDetails/Pairings/GenrePriorities seed structured data in edit mode. *@

<InlineAlert Messages="@ViewModel.ServerValidationErrors" />

<EditForm Model="@ViewModel" OnValidSubmit="HandleValidSubmit" FormName="story-properties-form"
          class="flex flex-col gap-6">
    <DataAnnotationsValidator />

    @* ── Title ───────────────────────────────────────────────────────────────── *@
    <div class="flex flex-col gap-1">
        <label for="story-title" class="text-sm font-semibold text-(--color-text)">Title</label>
        <InputText id="story-title" @bind-Value="ViewModel.Title" aria-describedby="story-title-error"
                   class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)"
                   placeholder="Story title" />
        <ValidationMessage id="story-title-error" For="@(() => ViewModel.Title)" class="text-sm text-(--color-danger)" />
    </div>

    @* ── Short description ────────────────────────────────────────────────────── *@
    <div class="flex flex-col gap-1">
        <label for="story-short-description" class="text-sm font-semibold text-(--color-text)">Short Description</label>
        <InputTextArea id="story-short-description" @bind-Value="ViewModel.ShortDescription" rows="2" aria-describedby="story-short-description-error"
                       class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)"
                       placeholder="One-line hook shown in story listings (max 500 chars)" />
        <ValidationMessage id="story-short-description-error" For="@(() => ViewModel.ShortDescription)" class="text-sm text-(--color-danger)" />
    </div>

    @* ── Rating + Status (side by side on wider screens) ─────────────────────── *@
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex flex-col gap-1">
            <label for="story-rating" class="text-sm font-semibold text-(--color-text)">Rating</label>
            <InputSelect id="story-rating" @bind-Value="ViewModel.Rating"
                         class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)">
                @foreach (Rating r in Enum.GetValues<Rating>())
                {
                    <option value="@r">@r.ToString()</option>
                }
            </InputSelect>
        </div>
        <div class="flex flex-col gap-1">
            <label for="story-status" class="text-sm font-semibold text-(--color-text)">Status</label>
            <InputSelect id="story-status" @bind-Value="ViewModel.StoryStatusId"
                         class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)">
                @foreach (StoryStatusEnum s in Enum.GetValues<StoryStatusEnum>())
                {
                    <option value="@s">@s.ToString()</option>
                }
            </InputSelect>
        </div>
    </div>

    @* ── Cover art ───────────────────────────────────────────────────────────── *@
    <div class="flex flex-col gap-2">
        <label for="story-cover-art" class="text-sm font-semibold text-(--color-text)">Cover Art</label>
        @if (!string.IsNullOrEmpty(ViewModel.CoverArtRelativeUrl))
        {
            <img src="@ViewModel.CoverArtRelativeUrl"
                 alt="Current cover"
                 class="h-32 w-24 rounded-md object-cover shadow-subtle" />
        }
        <InputFile id="story-cover-art" OnChange="HandleCoverSelected" accept="image/jpeg,image/png,image/webp"
                   class="text-sm text-(--color-text-muted) file:mr-3 file:rounded-md file:border-0 file:bg-(--color-action) file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-(--color-text) file:transition-colors hover:file:bg-(--color-action-hover)" />
        <p class="text-xs text-(--color-text-muted)">JPEG, PNG, or WebP · max 10 MB</p>
    </div>

    @* ── Long description (rich text) ─────────────────────────────────────────── *@
    <div class="flex flex-col gap-1" role="group" aria-labelledby="story-long-description-label">
        <span id="story-long-description-label" class="text-sm font-semibold text-(--color-text)">Summary / Long Description</span>
        <ContentSurface Variant="ContentSurfaceVariant.Input">
            <EditorView @ref="_editor" Html="@ViewModel.LongDescription" Placeholder="Full story summary…" />
        </ContentSurface>
    </div>

    @* ── Tags ────────────────────────────────────────────────────────────────── *@
    <div class="flex flex-col gap-6">
        <p class="text-sm font-semibold text-(--color-text)">Tags</p>

        @* Characters + per-entry detail + pairings. Rows are POSITIONAL with the chip list —
           a species may repeat with distinct custom names (WU-TagFanon). *@
        <div class="flex flex-col gap-2">
            <TagSelector @key="@($"{_characterChips.Count}:{string.Join(",", _characterChips.Select(c => c.TagId))}")"
                         TagType="TagTypeEnum.Character"
                         Label="Characters"
                         SelectedTags="@_characterChips"
                         AllowRepeatSelection="true"
                         OnSelectionChanged="HandleCharacterChange" />
            @for (int i = 0; i < _characterDtos.Count && i < _characterChips.Count; i++)
            {
                int idx = i;
                <CharacterEntry Chip="@_characterChips[idx]" Dto="@_characterDtos[idx]"
                                OfficialNameLookup="@OfficialNameLookup"
                                OnConvertToOfficial="@(chip => ConvertRowToOfficial(idx, chip))"
                                OnChanged="@(dto => OnCharacterDtoChanged(idx, dto))"
                                OnRemoved="@(() => RemoveCharacterRow(idx))" />
            }
        </div>

        @if (_characterChips.Count >= 2)
        {
            <div class="flex flex-col gap-1">
                <p class="text-sm font-medium text-(--color-text)">Character Pairings</p>
                <PairingBuilder CharacterChips="@_characterChips"
                                CharacterNames="@CharacterRowNames"
                                Pairings="@_pairings"
                                OnPairingsChanged="HandlePairingsChanged" />
            </div>
        }

        @* Settings — every chip gets the quiet overlay affordance (WU-TagFanon) *@
        <div class="flex flex-col gap-2">
            <TagSelector @key="@string.Join(",", _settingChips.Select(c => c.TagId))"
                         TagType="TagTypeEnum.Setting"
                         Label="Settings"
                         SelectedTags="@_settingChips"
                         OnSelectionChanged="HandleSettingChange" />
            @foreach (TagChipDto chip in _settingChips)
            {
                (string? name, string? nuance) = _flatOverlayMap.GetValueOrDefault(chip.TagId);
                <FlatTagOverlayEntry Chip="@chip" CustomName="@name" Nuance="@nuance"
                                     OnOverlayChanged="@(o => OnFlatOverlayChanged(chip.TagId, o))" />
            }
        </div>

        @* Genres — per-tag priority + the quiet overlay affordance *@
        <div class="flex flex-col gap-2">
            <TagSelector TagType="TagTypeEnum.Genre"
                         Label="Genres"
                         SelectedTags="@_genreChips"
                         OnSelectionChanged="HandleGenreChange" />
            @foreach (TagChipDto chip in _genreChips)
            {
                (string? name, string? nuance) = _flatOverlayMap.GetValueOrDefault(chip.TagId);
                <FlatTagOverlayEntry Chip="@chip" CustomName="@name" Nuance="@nuance"
                                     ShowPriority="true"
                                     Priority="@_genrePriorityMap.GetValueOrDefault(chip.TagId, TagPriority.Primary)"
                                     OnPriorityChanged="@(p => HandleGenrePriorityChange(chip.TagId, p))"
                                     OnOverlayChanged="@(o => OnFlatOverlayChanged(chip.TagId, o))" />
            }
        </div>

        @* Content Warnings + Crossover Fandoms — flat, quiet overlay, no priority UI *@
        <div class="flex flex-col gap-2">
            <TagSelector TagType="TagTypeEnum.ContentWarning"
                         Label="Content Warnings"
                         SelectedTags="@_cwChips"
                         OnSelectionChanged="HandleCwChange" />
            @foreach (TagChipDto chip in _cwChips)
            {
                (string? name, string? nuance) = _flatOverlayMap.GetValueOrDefault(chip.TagId);
                <FlatTagOverlayEntry Chip="@chip" CustomName="@name" Nuance="@nuance"
                                     OnOverlayChanged="@(o => OnFlatOverlayChanged(chip.TagId, o))" />
            }
        </div>
        <div class="flex flex-col gap-2">
            <TagSelector TagType="TagTypeEnum.CrossoverFandom"
                         Label="Crossover Fandoms"
                         SelectedTags="@_crossoverChips"
                         OnSelectionChanged="HandleCrossoverChange" />
            @foreach (TagChipDto chip in _crossoverChips)
            {
                (string? name, string? nuance) = _flatOverlayMap.GetValueOrDefault(chip.TagId);
                <FlatTagOverlayEntry Chip="@chip" CustomName="@name" Nuance="@nuance"
                                     OnOverlayChanged="@(o => OnFlatOverlayChanged(chip.TagId, o))" />
            }
        </div>
    </div>

    @* ── "Also posted on" external links + original dates (Feature 53 reframe, WU38d) ── *@
    <div class="flex flex-col gap-2">
        <p class="text-sm font-semibold text-(--color-text)">Also posted on</p>
        <p class="text-xs text-(--color-text-muted)">
            If this story is also live on other sites, list the links — they'll show on your story
            page. Paste the URL; the site is detected automatically. Verify your account for a
            platform in Settings, then request verification on each link — a moderator confirms
            it's you.
        </p>
        @for (int i = 0; i < ViewModel.ExternalLinks.Count; i++)
        {
            int idx = i;
            StoryExternalLinkEditDto link = ViewModel.ExternalLinks[idx];
            <div class="flex flex-col gap-1">
                <div class="flex items-center gap-2">
                    <input value="@link.Url"
                           @onchange="@(e => HandleLinkUrlChanged(idx, e.Value as string))"
                           placeholder="https://…"
                           class="min-w-0 flex-1 rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-1.5 text-sm text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-action-ink)" />
                    <select value="@link.ExternalPlatformId"
                            @onchange="@(e => link.ExternalPlatformId = short.Parse((string)e.Value!))"
                            aria-label="Platform"
                            class="rounded-md border border-(--color-border) bg-(--color-surface) px-2 py-1.5 text-sm text-(--color-text)">
                        @foreach (ExternalPlatformDto platform in ExternalPlatforms)
                        {
                            <option value="@platform.ExternalPlatformId">@platform.Name</option>
                        }
                    </select>
                    <button type="button" @onclick="() => RemoveExternalLink(idx)" aria-label="Remove link"
                            class="shrink-0 text-(--color-text-muted) hover:text-(--color-danger)">✕</button>
                </div>
                @* Verification status is only meaningful once the link is saved (has a real id). *@
                @if (link.StoryExternalLinkId != 0)
                {
                    <div class="flex flex-wrap items-center gap-2 pl-1 text-xs text-(--color-text-muted)">
                        <span>@StatusLabel(link)</span>
                        @if (link.VerificationStatus != VerificationStatusEnum.Verified)
                        {
                            bool canRequest = VerifiedPlatformIds.Contains(link.ExternalPlatformId);
                            <button type="button" disabled="@(!canRequest)"
                                    aria-label="Request verification"
                                    @onclick="() => OnRequestLinkVerification.InvokeAsync(link.StoryExternalLinkId)"
                                    class="text-(--color-action-ink) hover:underline disabled:cursor-not-allowed disabled:text-(--color-text-muted) disabled:no-underline">
                                Request verification
                            </button>
                            @if (!canRequest)
                            {
                                <span>— verify your @PlatformName(link.ExternalPlatformId) account in Settings first</span>
                            }
                        }
                    </div>
                }
            </div>
        }
        <button type="button" @onclick="AddExternalLink" aria-label="Add external link"
                class="self-start text-sm text-(--color-action-ink) hover:underline">+ Add link</button>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-1">
                <label for="story-original-published-date" class="text-xs text-(--color-text-muted)">Originally published (elsewhere)</label>
                <InputDate id="story-original-published-date" @bind-Value="ViewModel.OriginalPublishedDate"
                           class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-1.5 text-sm text-(--color-text)" />
            </div>
            <div class="flex flex-col gap-1">
                <label for="story-original-last-updated-date" class="text-xs text-(--color-text-muted)">Original last update</label>
                <InputDate id="story-original-last-updated-date" @bind-Value="ViewModel.OriginalLastUpdatedDate"
                           class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-1.5 text-sm text-(--color-text)" />
            </div>
        </div>
    </div>

    @* ── Submit ──────────────────────────────────────────────────────────────── *@
    <button type="submit"
            disabled="@ViewModel.IsLoading"
            aria-label="Save story properties"
            class="self-start rounded-md bg-(--color-action) px-5 py-2 font-medium text-(--color-text) transition-colors hover:bg-(--color-action-hover) disabled:opacity-50">
        @(ViewModel.IsLoading ? "Saving…" : SubmitLabel)
    </button>
</EditForm>

@code {
    [Parameter, EditorRequired] public StoryPropertiesViewModel ViewModel { get; set; } = null!;
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    /// <summary>
    /// Pre-populated tag chips per type for edit mode (seeded from GetTagChipsByIdsAsync).
    /// Null = create mode (all selectors start empty). Passed in before first render — not reactive.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<TagTypeEnum, IReadOnlyList<TagChipDto>>? InitialTagsByType { get; set; }

    /// <summary>Structured edit-mode seeds; all null in create mode.</summary>
    [Parameter] public IReadOnlyList<StoryCharacterDto>? InitialCharacters { get; set; }

    /// <summary>
    /// One chip per character ROW, positionally aligned with <see cref="InitialCharacters"/> —
    /// the type-grouped <see cref="InitialTagsByType"/> can't carry duplicates of one species
    /// (WU-TagFanon).
    /// </summary>
    [Parameter] public IReadOnlyList<TagChipDto>? InitialCharacterChips { get; set; }

    /// <summary>Flat-tag edit seeds (priority + CustomName/Nuance overlay per tag id).</summary>
    [Parameter] public IReadOnlyList<StoryTagDTO>? InitialFlatTags { get; set; }
    [Parameter] public IReadOnlyList<StoryCharacterPairingDto>? InitialPairings { get; set; }

    /// <summary>Editor-nudge lookup, threaded down to CharacterEntry (page-supplied I/O —
    /// this form stays injection-free). Null disables the nudge.</summary>
    [Parameter] public Func<string, Task<TagChipDto?>>? OfficialNameLookup { get; set; }

    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>
    /// Seeded platform lookup for the "Also posted on" section (WU38d) — loaded by the page
    /// (this form stays injection-free). Empty list hides nothing; rows just default to the
    /// first option.
    /// </summary>
    [Parameter] public IReadOnlyList<ExternalPlatformDto> ExternalPlatforms { get; set; } = [];

    /// <summary>
    /// Platform ids the caller already holds a Verified account-tier identity for (WU39) — gates
    /// each saved link row's "Request verification" button. Loaded by the page.
    /// </summary>
    [Parameter] public IReadOnlySet<short> VerifiedPlatformIds { get; set; } = new HashSet<short>();

    /// <summary>Fires with the saved link's <c>StoryExternalLinkId</c> when the author requests per-link review (WU39).</summary>
    [Parameter] public EventCallback<int> OnRequestLinkVerification { get; set; }

    private EditorView? _editor;

    // Per-type chip lists (kept in sync with TagSelector OnSelectionChanged)
    private List<TagChipDto> _characterChips = new();
    private List<TagChipDto> _settingChips = new();
    private List<TagChipDto> _genreChips = new();
    private List<TagChipDto> _cwChips = new();
    private List<TagChipDto> _crossoverChips = new();

    // Structured state
    private List<StoryCharacterDto> _characterDtos = new();
    private Dictionary<int, (string? CustomName, string? Nuance)> _flatOverlayMap = new();
    private Dictionary<int, TagPriority> _genrePriorityMap = new();
    private List<StoryCharacterPairingDto> _pairings = new();

    // Per-row display names for the pairing builder (CustomName-aware).
    private IReadOnlyList<string> CharacterRowNames =>
        _characterDtos
            .Select((d, i) => d.CustomName is { Length: > 0 } name
                ? name
                : i < _characterChips.Count ? _characterChips[i].TagName : $"#{i}")
            .ToList();

    /// <summary>The most recently selected cover file, or null if none was picked this session.</summary>
    public IBrowserFile? SelectedCoverFile { get; private set; }

    /// <summary>Pull the current editor HTML. Called by the page on submit before building the DTO.</summary>
    public async Task<string> GetLongDescriptionAsync() =>
        _editor is not null ? await _editor.GetHtmlAsync() : string.Empty;

    // Push counterpart for draft restore (DraftAutosave) — Quill ignores later Html parameter
    // changes, so restored content must go through EditorView.SetHtmlAsync.
    public async Task SetLongDescriptionAsync(string html)
    {
        if (_editor is not null) await _editor.SetHtmlAsync(html);
    }

    protected override void OnInitialized()
    {
        if (InitialTagsByType is not null)
        {
            foreach ((TagTypeEnum type, IReadOnlyList<TagChipDto> chips) in InitialTagsByType)
            {
                switch (type)
                {
                    // Character chips arrive via InitialCharacterChips (positional) — not here.
                    case TagTypeEnum.Setting:   _settingChips   = chips.ToList(); break;
                    case TagTypeEnum.Genre:     _genreChips     = chips.ToList(); break;
                    case TagTypeEnum.ContentWarning:  _cwChips       = chips.ToList(); break;
                    case TagTypeEnum.CrossoverFandom: _crossoverChips = chips.ToList(); break;
                }
            }
        }

        if (InitialCharacters is not null)
            _characterDtos = InitialCharacters.ToList();
        if (InitialCharacterChips is not null)
            _characterChips = InitialCharacterChips.ToList();

        if (InitialFlatTags is not null)
        {
            foreach (StoryTagDTO t in InitialFlatTags)
            {
                if (t.CustomName is not null || t.Nuance is not null)
                    _flatOverlayMap[t.TagId] = (t.CustomName, t.Nuance);
                if (t.TagTypeEnum == TagTypeEnum.Genre)
                    _genrePriorityMap[t.TagId] = t.Priority;
            }
        }

        if (InitialPairings is not null)
            _pairings = InitialPairings.ToList();

        RebuildViewModel();
    }

    // ── Character handlers (row-based — WU-TagFanon) ──────────────────────────

    private void HandleCharacterChange(IReadOnlyList<TagChipDto> chips)
    {
        // Positional reconciliation: consume old (chip,dto) rows greedily by TagId so surviving
        // rows keep their overlay data, then remap pairing member indexes old→new.
        List<TagChipDto> oldChips = _characterChips;
        List<StoryCharacterDto> oldDtos = _characterDtos;
        bool[] used = new bool[oldChips.Count];
        int?[] mapping = new int?[oldChips.Count];

        List<TagChipDto> newChips = chips.ToList();
        List<StoryCharacterDto> newDtos = new(newChips.Count);
        for (int j = 0; j < newChips.Count; j++)
        {
            int match = -1;
            for (int i = 0; i < oldChips.Count; i++)
            {
                if (!used[i] && oldChips[i].TagId == newChips[j].TagId) { match = i; break; }
            }
            if (match >= 0 && match < oldDtos.Count)
            {
                used[match] = true;
                mapping[match] = j;
                newDtos.Add(oldDtos[match]);
            }
            else
            {
                newDtos.Add(new StoryCharacterDto { CharacterTagId = newChips[j].TagId });
            }
        }

        _characterChips = newChips;
        _characterDtos = newDtos;
        RemapPairings(mapping);
        RebuildViewModel();
    }

    private void OnCharacterDtoChanged(int index, StoryCharacterDto dto)
    {
        _characterDtos[index] = dto;
        RebuildViewModel();
    }

    /// <summary>The author accepted the editor nudge: switch the row to the official tag —
    /// naming moves to the tag, the note survives (same shape as server-side adoption).</summary>
    private void ConvertRowToOfficial(int index, TagChipDto officialChip)
    {
        StoryCharacterDto old = _characterDtos[index];
        _characterChips[index] = officialChip;
        _characterDtos[index] = new StoryCharacterDto
        {
            CharacterTagId = officialChip.TagId,
            Priority = old.Priority,
            IsOc = false,
            CustomName = null,
            Nuance = old.Nuance
        };
        RebuildViewModel();
    }

    private void RemoveCharacterRow(int index)
    {
        int?[] mapping = new int?[_characterDtos.Count];
        for (int i = 0; i < mapping.Length; i++)
            mapping[i] = i < index ? i : i == index ? null : i - 1;

        _characterDtos.RemoveAt(index);
        if (index < _characterChips.Count) _characterChips.RemoveAt(index);
        RemapPairings(mapping);
        RebuildViewModel();
    }

    /// <summary>Remaps pairing member indexes through an old→new row mapping (null = row removed);
    /// pairings falling below 2 distinct members are dropped.</summary>
    private void RemapPairings(int?[] mapping)
    {
        _pairings = _pairings
            .Select(p => new StoryCharacterPairingDto
            {
                PairingType = p.PairingType, Priority = p.Priority,
                MemberIndexes = p.MemberIndexes
                    .Where(m => m >= 0 && m < mapping.Length && mapping[m] is not null)
                    .Select(m => mapping[m]!.Value)
                    .ToList()
            })
            .Where(p => p.MemberIndexes.Distinct().Count() >= 2)
            .ToList();
    }

    // ── Setting handlers ──────────────────────────────────────────────────────

    private void HandleSettingChange(IReadOnlyList<TagChipDto> chips)
    {
        _settingChips = chips.ToList();
        PruneFlatOverlays();
        RebuildViewModel();
    }

    private void OnFlatOverlayChanged(int tagId, (string? CustomName, string? Nuance) overlay)
    {
        if (overlay.CustomName is null && overlay.Nuance is null)
            _flatOverlayMap.Remove(tagId);
        else
            _flatOverlayMap[tagId] = overlay;
        RebuildViewModel();
    }

    /// <summary>Drops overlay entries whose tag is no longer selected on any flat axis.</summary>
    private void PruneFlatOverlays()
    {
        HashSet<int> selected =
        [
            .._settingChips.Select(c => c.TagId),
            .._genreChips.Select(c => c.TagId),
            .._cwChips.Select(c => c.TagId),
            .._crossoverChips.Select(c => c.TagId),
        ];
        foreach (int id in _flatOverlayMap.Keys.Where(k => !selected.Contains(k)).ToList())
            _flatOverlayMap.Remove(id);
    }

    // ── Genre handlers ────────────────────────────────────────────────────────

    private void HandleGenreChange(IReadOnlyList<TagChipDto> chips)
    {
        HashSet<int> newIds = chips.Select(c => c.TagId).ToHashSet();
        foreach (int id in _genrePriorityMap.Keys.Where(k => !newIds.Contains(k)).ToList())
            _genrePriorityMap.Remove(id);
        _genreChips = chips.ToList();
        PruneFlatOverlays();
        RebuildViewModel();
    }

    private void HandleGenrePriorityChange(int tagId, TagPriority priority)
    {
        _genrePriorityMap[tagId] = priority;
        RebuildViewModel();
    }

    // ── CW / Crossover handlers ───────────────────────────────────────────────

    private void HandleCwChange(IReadOnlyList<TagChipDto> chips)
    {
        _cwChips = chips.ToList();
        PruneFlatOverlays();
        RebuildViewModel();
    }

    private void HandleCrossoverChange(IReadOnlyList<TagChipDto> chips)
    {
        _crossoverChips = chips.ToList();
        PruneFlatOverlays();
        RebuildViewModel();
    }

    // ── Pairing handler ───────────────────────────────────────────────────────

    private void HandlePairingsChanged(List<StoryCharacterPairingDto> pairings)
    {
        _pairings = pairings;
        RebuildViewModel();
    }

    // ── ViewModel rebuild ─────────────────────────────────────────────────────

    private void RebuildViewModel()
    {
        ViewModel.SelectedCharacters = new List<StoryCharacterDto>(_characterDtos);
        ViewModel.SelectedPairings   = new List<StoryCharacterPairingDto>(_pairings);
        ViewModel.SelectedFlatTags =
        [
            .._settingChips.Select(c  => FlatTag(c, TagTypeEnum.Setting, TagPriority.Primary)),
            .._genreChips.Select(c    => FlatTag(c, TagTypeEnum.Genre, _genrePriorityMap.GetValueOrDefault(c.TagId, TagPriority.Primary))),
            .._cwChips.Select(c       => FlatTag(c, TagTypeEnum.ContentWarning, TagPriority.Primary)),
            .._crossoverChips.Select(c => FlatTag(c, TagTypeEnum.CrossoverFandom, TagPriority.Primary)),
        ];
    }

    private StoryTagDTO FlatTag(TagChipDto chip, TagTypeEnum type, TagPriority priority)
    {
        (string? name, string? nuance) = _flatOverlayMap.GetValueOrDefault(chip.TagId);
        return new StoryTagDTO
        {
            TagId = chip.TagId, TagTypeEnum = type, Priority = priority,
            CustomName = name, Nuance = nuance
        };
    }

    private void HandleCoverSelected(InputFileChangeEventArgs e) =>
        SelectedCoverFile = e.File;

    // ── "Also posted on" link rows (WU38d) ───────────────────────────────────────

    private void AddExternalLink() =>
        ViewModel.ExternalLinks.Add(new StoryExternalLinkEditDto
        {
            // Default to the "Other" row (no DomainPattern) until a URL is pasted and detected.
            ExternalPlatformId = FallbackPlatformId()
        });

    private void RemoveExternalLink(int index) =>
        ViewModel.ExternalLinks.RemoveAt(index);

    /// <summary>
    /// Paste-a-URL auto-detect: match the URL's host against each platform's DomainPattern and
    /// stamp the row's platform. Runs on every URL change (a changed host re-detects); the
    /// dropdown remains manually overridable afterwards.
    /// </summary>
    private void HandleLinkUrlChanged(int index, string? url)
    {
        StoryExternalLinkEditDto link = ViewModel.ExternalLinks[index];
        link.Url = url?.Trim() ?? string.Empty;

        if (Uri.TryCreate(link.Url, UriKind.Absolute, out Uri? uri))
        {
            ExternalPlatformDto? detected = ExternalPlatforms.FirstOrDefault(p =>
                p.DomainPattern is not null &&
                uri.Host.Contains(p.DomainPattern, StringComparison.OrdinalIgnoreCase));
            link.ExternalPlatformId = detected?.ExternalPlatformId ?? FallbackPlatformId();
        }
    }

    /// <summary>The "Other" row (null DomainPattern), or the first platform as a last resort.</summary>
    private short FallbackPlatformId() =>
        ExternalPlatforms.FirstOrDefault(p => p.DomainPattern is null)?.ExternalPlatformId
        ?? ExternalPlatforms.FirstOrDefault()?.ExternalPlatformId
        ?? (short)0;

    /// <summary>Author-facing per-link verification status label (WU39). No dates, no checkmark — see StoryExternalLinksRow for the reader-facing model.</summary>
    private static string StatusLabel(StoryExternalLinkEditDto link) =>
        LinkVerificationStatusHelper.GetDisplayStatus(link.VerificationStatus, link.VerificationRequested) switch
        {
            LinkVerificationDisplayStatus.Confirmed => "Confirmed",
            LinkVerificationDisplayStatus.PendingReview => "Pending moderator review",
            LinkVerificationDisplayStatus.Rejected => link.RejectionReason is { Length: > 0 } reason
                ? $"Not confirmed — {reason}"
                : "Not confirmed",
            _ => "Not yet requested",
        };

    private string PlatformName(short platformId) =>
        ExternalPlatforms.FirstOrDefault(p => p.ExternalPlatformId == platformId)?.Name ?? "this platform";

    private async Task HandleValidSubmit() => await OnValidSubmit.InvokeAsync();
}
