@page "/story/new"
@page "/story/{StoryId:int}/edit"
@namespace TheCanalaveLibrary.SharedUI
@attribute [Authorize]
@inject IStoryReadService StoryReadService
@inject IStoryWriteService StoryWriteService
@inject IExternalVerificationReadService ExternalVerificationReadService
@inject IExternalVerificationWriteService ExternalVerificationWriteService
@inject ITagReadService TagReadService
@inject IFanonReadService FanonReadService
@inject NavigationManager NavigationManager
@inject ILogger<StoryEditorPage> Logger
@using TheCanalaveLibrary.Core
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging

@* Story create/edit page — Pattern 1 edit side (cross-cutting.md "Two content-editing patterns").
   View side is StoryPage / WU25. This page owns routing, auth, data-load, the cover calls, and
   DTO-mapping. StoryPropertiesForm is a presentational child (no inject, bUnit-testable).
   The cover is never on a write DTO (owner ruling D14): in edit mode a picked file is uploaded and
   persisted at once (UploadCoverArtAsync) and "Remove cover" clears it (RemoveCoverArtAsync); in
   create mode the picked file waits for CreateStoryAsync's id. Form-cancel does not revert a cover.
   Its three writes (a cover call, the save, a status change) never overlap (see CoverChangeBlocked). *@

<PageTitle>@(StoryId.HasValue ? "Edit Story" : "New Story")</PageTitle>

@if (_isLoading)
{
    <p class="text-(--color-text-muted)"><em>Loading…</em></p>
}
else if (_forbidden)
{
    <p class="text-(--color-danger)">You don't have permission to edit this story.</p>
}
else
{
    <div class="mx-auto max-w-2xl px-4 py-8">
        <h1 class="mb-6 inline-block rounded-md border border-(--color-border) bg-(--color-surface-raised) px-4 py-1.5 font-display text-xl font-semibold text-(--color-text)">
            @(StoryId.HasValue ? "Edit Story" : "New Story")
        </h1>

        @* ── Draft safety (cross-cutting.md §"Error Handling Strategy") ─────────── *@
        <div class="mb-4">
            <DraftAutosave @ref="_autosave" @key="@DraftKey"
                           DraftKey="@DraftKey"
                           Capture="CaptureDraftAsync"
                           OnRestore="RestoreDraftAsync" />
        </div>

        @* ── Publication lifecycle (WU-StoryLifecycle, D1) — edit mode only (a new story is
           always a Draft and has no id to transition yet). The status updates IN PLACE: never
           NavigateTo this same route here — a same-route navigation on this Quill-hosting page is
           the WASM removeChild crash the save path's forceLoad works around. ─────────────── *@
        @if (StoryId.HasValue)
        {
            <div class="mb-6 flex flex-col gap-2">
                <InlineAlert Message="@_lifecycleNotice" Variant="InlineAlertVariant.Success" />
                <ErrorAlert Messages="_lifecycleErrors" ShowSignIn="_lifecycleErrorIsSessionExpired" />
                <StoryLifecyclePanel CurrentStatus="_currentStatus"
                                     SavedPostApprovalStatus="_savedPostApprovalStatus"
                                     RejectionReason="@_rejectionReason"
                                     IsBusy="@(_transitioning || _coverUploadBusy || _viewModel.IsLoading)"
                                     OnTransition="HandleTransitionAsync" />
            </div>
        }

        <StoryPropertiesForm @ref="_form"
                             ViewModel="_viewModel"
                             ShowPostApprovalStatus="@(!StoryLifecycle.IsPublished(_currentStatus))"
                             InitialTagsByType="_initialTagsByType"
                             InitialCharacters="_initialCharacters"
                             InitialCharacterChips="_initialCharacterChips"
                             InitialFlatTags="_initialFlatTags"
                             InitialPairings="_initialPairings"
                             OfficialNameLookup="@(name => FanonReadService.FindOfficialTagByNameAsync(TagTypeEnum.Character, name))"
                             ExternalPlatforms="@(ExternalPlatforms ?? [])"
                             VerifiedPlatformIds="@((IReadOnlySet<short>)(VerifiedPlatformIds ?? []))"
                             OnRequestLinkVerification="HandleRequestLinkVerification"
                             OnCoverSelected="HandleCoverSelectedAsync"
                             CoverUploadBusy="_coverUploadBusy"
                             OtherWriteInFlight="_transitioning"
                             OnRemoveCover="HandleRemoveCoverAsync"
                             SubmitLabel="@(StoryId.HasValue ? "Save Changes" : "Create Story")"
                             OnValidSubmit="HandleValidSubmit" />

        @* ── Bulk chapter import (Feature 63, WU38d) — edit mode only (needs a story id) ── *@
        @if (StoryId.HasValue)
        {
            @* Chapter reorder/delete + arc management (WU45) — edit-mode-only panels; the write
               services author-gate every mutation (server authority, WU24 principle). *@
            <div class="mt-8">
                <ChapterManagerPanel StoryId="@StoryId.Value" />
            </div>
            <div class="mt-8">
                <StoryArcManagerPanel StoryId="@StoryId.Value" />
            </div>

            <div class="mt-8">
                <StoryChapterImport StoryId="@StoryId.Value" />
            </div>

            @* Story Lineage management lives on its own owner-wide page (Feature 10, WU42 settled
               decision) — this is just a discoverable redirect from the editing context. *@
            <div class="mt-4">
                <a href="/story-lineages" class="text-sm text-(--color-action-ink) hover:underline">
                    Manage story lineage →
                </a>
            </div>

            @* Same pattern for Story Acknowledgments (WU-StatBadgeProducers) — its own owner-wide
               page, mirroring the lineage redirect above. *@
            <div class="mt-2">
                <a href="/acknowledgments" class="text-sm text-(--color-action-ink) hover:underline">
                    Manage acknowledgments →
                </a>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int? StoryId { get; set; }

    private StoryPropertiesForm? _form;
    private DraftAutosave? _autosave;
    private StoryPropertiesViewModel _viewModel = new();
    private IReadOnlyDictionary<TagTypeEnum, IReadOnlyList<TagChipDto>>? _initialTagsByType;
    private IReadOnlyList<StoryCharacterDto>? _initialCharacters;
    private IReadOnlyList<TagChipDto>? _initialCharacterChips;
    private IReadOnlyList<StoryTagDTO>? _initialFlatTags;
    private IReadOnlyList<StoryCharacterPairingDto>? _initialPairings;
    private bool _isLoading = true;
    private bool _forbidden;

    // Cover state (owner ruling D14). Edit mode uploads on pick, so only the busy flag lives here; create
    // mode has no story id yet, so the picked file waits in _pendingCoverFile until CreateStoryAsync.
    private const long MaxCoverBytes = 10 * 1024 * 1024; // ImageUploadRules.MaxBytes (server-side)
    private bool _coverUploadBusy;
    private IBrowserFile? _pendingCoverFile;

    // The page's three writes (a cover call, the save, the status change) never overlap (WU-BlobCleanup
    // review fixes, 2026-10-13; layer2-services.md, "the write context stays plain AddDbContext"): the
    // save ends in a forceLoad reload that would abort an upload still streaming, and under
    // InteractiveServer every write here shares the circuit's one scoped write context, which refuses a
    // second operation mid-flight. Each write's controls are disabled while another runs (the form's
    // CoverUploadBusy/OtherWriteInFlight/IsLoading, the lifecycle panel's IsBusy), and each handler
    // re-checks, for an event that beat the re-render.
    private bool CoverChangeBlocked => _coverUploadBusy || _viewModel.IsLoading || _transitioning;

    // Lifecycle state (WU-StoryLifecycle, D1), loaded from the edit DTO's read echoes. A new story
    // is always Draft. _savedPostApprovalStatus is the PERSISTED value — the form's select edits
    // _viewModel.PostApprovalStatus, which only reaches the server on Save (and Save reloads).
    private StoryStatusEnum _currentStatus = StoryStatusEnum.Draft;
    private StoryStatusEnum _savedPostApprovalStatus;
    private string? _rejectionReason;
    private bool _transitioning;
    private string? _lifecycleNotice;
    private readonly List<string> _lifecycleErrors = [];
    private bool _lifecycleErrorIsSessionExpired;

    // Persisted lookup lists (prerender→interactive, [PersistentState]) — both are rendered by the
    // form, so persisting adds no browser exposure. The edit-source StoryEditDTO is deliberately
    // NOT persisted: its List<IStoryTag> interface member doesn't survive the default-settings
    // System.Text.Json round trip [PersistentState] uses (no [JsonDerivedType] config on IStoryTag),
    // so the edit-mode source fetch runs on both passes until that DTO gets a serializable shape.
    // The live form/viewmodel and DraftAutosave state are never persisted (editor-page rule).
    [PersistentState] public IReadOnlyList<ExternalPlatformDto>? ExternalPlatforms { get; set; }
    [PersistentState] public List<TagChipDto>? TagChips { get; set; }

    /// <summary>
    /// Platform ids the author already holds a Verified account-tier identity for (WU39) — gates
    /// each saved link row's "Request verification" button. Edit mode only (create mode has no
    /// saved links yet to request review for).
    /// </summary>
    [PersistentState] public HashSet<short>? VerifiedPlatformIds { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Seeded platform lookup for the "Also posted on" section (WU38d) — needed in both modes.
        ExternalPlatforms ??= await StoryReadService.GetExternalPlatformsAsync();

        if (StoryId.HasValue)
        {
            // The service throws UnauthorizedAccessException for a non-author (the real gate,
            // both render modes — endpoint-authz sweep 2026-07-18) — render the forbidden state,
            // mirroring ChapterEditorPage's load-path handling.
            StoryEditDTO? editData;
            try
            {
                editData = await StoryReadService.GetStoryForEditAsync(StoryId.Value);
            }
            catch (UnauthorizedAccessException)
            {
                _forbidden = true;
                _isLoading = false;
                return;
            }

            if (editData is null)
            {
                NavigationManager.NotFound();
                return;
            }

            PopulateViewModelFromEdit(editData);

            // Load chip data for all tags (flat tags + character tags; TagSelector needs display data).
            // ??= — chip display data restores from the prerender payload; the grouped dictionary is
            // derived from it deterministically on every pass. Character chips are carved out
            // POSITIONALLY (duplicates of a species are legal — WU-TagFanon), so they ride first
            // in the id list and the grouped dictionary is built from the flat remainder only.
            List<int> charTagIds = editData.StoryCharacters.Select(c => c.CharacterTagId).ToList();
            List<int> flatTagIds = editData.StoryTags.Select(t => t.TagId).ToList();
            List<int> allTagIds = [..charTagIds, ..flatTagIds];
            if (allTagIds.Count > 0)
            {
                TagChips ??= await TagReadService.GetTagChipsByIdsAsync(allTagIds);
                _initialCharacterChips = TagChips.Take(charTagIds.Count).ToList();
                _initialTagsByType = TagChips.Skip(charTagIds.Count)
                    .GroupBy(c => c.TagTypeId)
                    .ToDictionary(g => g.Key, g => (IReadOnlyList<TagChipDto>)[.. g]);
            }
            _initialCharacters = editData.StoryCharacters;
            _initialFlatTags   = editData.StoryTags.OfType<StoryTagDTO>().ToList();
            _initialPairings   = editData.StoryCharacterPairings;

            VerifiedPlatformIds ??= (await ExternalVerificationReadService.GetMyExternalAccountsAsync())
                .Where(a => a.Status == VerificationStatusEnum.Verified)
                .Select(a => a.ExternalPlatformId)
                .ToHashSet();
        }

        _isLoading = false;
    }

    private void PopulateViewModelFromEdit(StoryEditDTO dto)
    {
        _viewModel.Title = dto.Title;
        _viewModel.ShortDescription = dto.ShortDescription;
        _viewModel.Rating = dto.Rating;
        _viewModel.CoverArtRelativeUrl = dto.CoverArtRelativeUrl;
        _viewModel.LongDescription = dto.LongDescription;
        _viewModel.PostApprovalStatus = dto.PostApprovalStatus;
        _viewModel.ExternalLinks = dto.ExternalLinks;
        _viewModel.OriginalPublishedDate = dto.OriginalPublishedDate;
        _viewModel.OriginalLastUpdatedDate = dto.OriginalLastUpdatedDate;

        _currentStatus = dto.StoryStatusId;
        _savedPostApprovalStatus = dto.PostApprovalStatus;
        _rejectionReason = dto.RejectionReason;
    }

    /// <summary>
    /// Lifecycle move from <see cref="StoryLifecyclePanel"/>. Updates the status IN PLACE from the
    /// RESULTING status the server returns (a trusted author's submit publishes directly) — no
    /// NavigateTo, see the panel's markup comment.
    /// </summary>
    private async Task HandleTransitionAsync(StoryStatusEnum target)
    {
        // Never start a second write under one in flight (see CoverChangeBlocked).
        if (!StoryId.HasValue || _coverUploadBusy || _viewModel.IsLoading || _transitioning) return;

        bool wasPublished = StoryLifecycle.IsPublished(_currentStatus);
        _transitioning = true;
        _lifecycleNotice = null;
        _lifecycleErrors.Clear();
        _lifecycleErrorIsSessionExpired = false;

        try
        {
            StoryStatusEnum result = await StoryWriteService.TransitionStatusAsync(StoryId.Value, target);
            _currentStatus = result;
            if (result != StoryStatusEnum.Rejected) _rejectionReason = null;
            _lifecycleNotice = result switch
            {
                StoryStatusEnum.PendingApproval => "Submitted for review.",
                StoryStatusEnum.Draft when wasPublished => "Unpublished — the story is a draft again.",
                StoryStatusEnum.Draft => "Moved back to draft.",
                _ when wasPublished => $"Status updated to {StoryDisplayFormat.StatusLabel(result)}.",
                _ => "Published.",
            };
        }
        catch (UnauthorizedAccessException)
        {
            _forbidden = true;
        }
        catch (Exception ex)
        {
            if (!ExceptionPresenter.IsUserFacing(ex))
                Logger.LogError(ex, "Changing the status of story {StoryId} failed unexpectedly", StoryId);
            _lifecycleErrors.AddRange(ExceptionPresenter.GetUserMessages(ex));
            _lifecycleErrorIsSessionExpired = ex is SessionExpiredException;
        }
        finally
        {
            _transitioning = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        // The submit is disabled while another write runs; this guards the click that beat the re-render.
        if (_coverUploadBusy || _transitioning || _viewModel.IsLoading) return;

        _viewModel.IsLoading = true;
        _viewModel.ServerValidationErrors.Clear();

        try
        {
            // Pull long description from the EditorView (pull-on-submit — Blazored.TextEditor pattern).
            string longDescription = _form is not null
                ? await _form.GetLongDescriptionAsync()
                : string.Empty;
            _viewModel.LongDescription = longDescription;

            // Structured collections — built by the form on every selection change.
            List<IStoryTag> flatTags = _viewModel.SelectedFlatTags.Cast<IStoryTag>().ToList();
            List<StoryCharacterDto> characters   = _viewModel.SelectedCharacters;
            List<StoryCharacterPairingDto> pairings = _viewModel.SelectedPairings;

            if (StoryId.HasValue)
            {
                // Edit path.
                var updateDto = new StoryUpdateDTO
                {
                    StoryId = StoryId.Value,
                    Title = _viewModel.Title,
                    ShortDescription = _viewModel.ShortDescription,
                    Rating = _viewModel.Rating,
                    LongDescription = _viewModel.LongDescription,
                    PostApprovalStatus = _viewModel.PostApprovalStatus,
                    StoryTags = flatTags,
                    StoryCharacters = characters,
                    StoryCharacterPairings = pairings,
                    ExternalLinks = _viewModel.ExternalLinks,
                    OriginalPublishedDate = _viewModel.OriginalPublishedDate,
                    OriginalLastUpdatedDate = _viewModel.OriginalLastUpdatedDate
                };

                // No cover here: it was persisted the moment it was picked (HandleCoverSelectedAsync).
                await StoryWriteService.UpdateStoryAsync(updateDto);
                if (_autosave is not null) await _autosave.ClearAsync(); // persisted save supersedes the local backup
                // forceLoad: same-component redirect on a Quill-hosting page. An in-place re-render
                // fine-grained-diffs around Quill's JS-inserted toolbar DOM and crashes the WASM
                // renderer with removeChild-of-null (Blazored.TextEditor#71 — the circuit renderer
                // tolerated it; found in the Global Flip wave). A full document nav tears down the
                // whole region root-first, which is safe — and [PersistentState] makes the reload
                // hydrate from the prerender payload, so the cost is invisible.
                NavigationManager.NavigateTo($"/story/{StoryId.Value}/edit", forceLoad: true);
            }
            else
            {
                // Create path — AuthorId is server-stamped in CreateStoryAsync.
                var createDto = new CreateStoryDTO
                {
                    Title = _viewModel.Title,
                    ShortDescription = _viewModel.ShortDescription,
                    Rating = _viewModel.Rating,
                    LongDescription = _viewModel.LongDescription,
                    PostApprovalStatus = _viewModel.PostApprovalStatus,
                    StoryTags = flatTags,
                    StoryCharacters = characters,
                    StoryCharacterPairings = pairings,
                    ExternalLinks = _viewModel.ExternalLinks,
                    OriginalPublishedDate = _viewModel.OriginalPublishedDate,
                    OriginalLastUpdatedDate = _viewModel.OriginalLastUpdatedDate
                };

                int newStoryId = await StoryWriteService.CreateStoryAsync(createDto);

                // Upload the picked cover now that the story has an id. UploadCoverArtAsync persists it
                // itself (owner ruling D14), so there is no second UpdateStoryAsync. Known gap, unchanged
                // here: if this upload fails, the story exists but the page stays on /story/new.
                if (_pendingCoverFile is { } coverFile)
                {
                    await using Stream stream = coverFile.OpenReadStream(MaxCoverBytes);
                    await StoryWriteService.UploadCoverArtAsync(stream, coverFile.ContentType, newStoryId);
                    _pendingCoverFile = null;
                }

                if (_autosave is not null) await _autosave.ClearAsync(); // persisted save supersedes the local backup
                // forceLoad: same-component create→edit redirect — see the update path's comment.
                NavigationManager.NavigateTo($"/story/{newStoryId}/edit", forceLoad: true);
            }
        }
        catch (UnauthorizedAccessException)
        {
            _forbidden = true;
        }
        catch (Exception ex)
        {
            if (!ExceptionPresenter.IsUserFacing(ex))
                Logger.LogError(ex, "Saving story {StoryId} failed unexpectedly", StoryId);
            _viewModel.ServerValidationErrors.AddRange(ExceptionPresenter.GetUserMessages(ex));
        }
        finally
        {
            _viewModel.IsLoading = false;
        }
    }

    /// <summary>
    /// A cover file was picked (owner ruling D14). Edit mode: upload it now — the service persists it
    /// and deletes the old blob — and show the returned path without a save. Create mode: there is no
    /// story id yet, so hold the file until <see cref="HandleValidSubmit"/> has created the story.
    /// </summary>
    private async Task HandleCoverSelectedAsync(IBrowserFile file)
    {
        // The picker is disabled while another write runs; this guards a pick that beat the re-render.
        if (CoverChangeBlocked) return;

        if (!StoryId.HasValue)
        {
            _pendingCoverFile = file;
            return;
        }

        await RunCoverChangeAsync(async () =>
        {
            await using Stream stream = file.OpenReadStream(MaxCoverBytes);
            _viewModel.CoverArtRelativeUrl =
                await StoryWriteService.UploadCoverArtAsync(stream, file.ContentType, StoryId.Value);
        }, "upload");
    }

    /// <summary>"Remove cover" (edit mode only — the button shows only while a cover is set, and a new
    /// story has none). Commits at once, like the upload.</summary>
    private async Task HandleRemoveCoverAsync()
    {
        if (!StoryId.HasValue || CoverChangeBlocked) return;

        await RunCoverChangeAsync(async () =>
        {
            await StoryWriteService.RemoveCoverArtAsync(StoryId.Value);
            _viewModel.CoverArtRelativeUrl = null;
        }, "remove");
    }

    /// <summary>The cover calls' shared busy flag and error handling: a 403 renders the forbidden
    /// state; anything else shows in the form's error list through <c>ExceptionPresenter</c>, logged
    /// only when it is not a user-facing refusal (the save path's shape).</summary>
    private async Task RunCoverChangeAsync(Func<Task> change, string operation)
    {
        _coverUploadBusy = true;
        _viewModel.ServerValidationErrors.Clear();
        try
        {
            await change();
        }
        catch (UnauthorizedAccessException)
        {
            _forbidden = true;
        }
        catch (Exception ex)
        {
            if (!ExceptionPresenter.IsUserFacing(ex))
                Logger.LogError(ex, "Cover {CoverOperation} for story {StoryId} failed unexpectedly", operation, StoryId);
            _viewModel.ServerValidationErrors.AddRange(ExceptionPresenter.GetUserMessages(ex));
        }
        finally
        {
            _coverUploadBusy = false;
        }
    }

    /// <summary>Author requests per-link review (WU39) — refreshes only the link statuses, not the whole edit DTO, so in-progress unsaved edits elsewhere on the form survive.</summary>
    private async Task HandleRequestLinkVerification(int storyExternalLinkId)
    {
        if (!StoryId.HasValue) return;

        _viewModel.ServerValidationErrors.Clear();
        try
        {
            await ExternalVerificationWriteService.RequestLinkVerificationAsync(storyExternalLinkId);

            StoryUpdateDTO? refreshed = await StoryReadService.GetStoryForEditAsync(StoryId.Value);
            if (refreshed is not null)
                _viewModel.ExternalLinks = refreshed.ExternalLinks;
        }
        catch (Exception ex)
        {
            if (!ExceptionPresenter.IsUserFacing(ex))
                Logger.LogError(ex, "Requesting link verification failed unexpectedly for link {LinkId}", storyExternalLinkId);
            _viewModel.ServerValidationErrors.AddRange(ExceptionPresenter.GetUserMessages(ex));
        }
    }

    // ── Draft safety (DraftAutosave contract). Prose fields only — structured tag/character
    // selections are picker state, not typed work; re-selecting them is cheap, re-typing a
    // description is not. ─────────────────────────────────────────────────────────
    private string DraftKey => StoryId.HasValue ? $"draft:story:{StoryId.Value}" : "draft:story:new";

    private async Task<Dictionary<string, string?>?> CaptureDraftAsync()
    {
        if (_form is null || _isLoading) return null;
        return new Dictionary<string, string?>
        {
            ["Title"] = _viewModel.Title,
            ["ShortDescription"] = _viewModel.ShortDescription,
            ["LongDescription"] = await _form.GetLongDescriptionAsync(),
        };
    }

    private async Task RestoreDraftAsync(IReadOnlyDictionary<string, string?> fields)
    {
        if (_form is null) return;
        _viewModel.Title = fields.GetValueOrDefault("Title") ?? _viewModel.Title;
        _viewModel.ShortDescription = fields.GetValueOrDefault("ShortDescription") ?? _viewModel.ShortDescription;
        await _form.SetLongDescriptionAsync(fields.GetValueOrDefault("LongDescription") ?? string.Empty);
        StateHasChanged();
    }
}
