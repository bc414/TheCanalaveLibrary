@namespace TheCanalaveLibrary.SharedUI
@using TheCanalaveLibrary.Core

@* Leaf — inline, non-blocking "Did this recommendation help you find this story?" banner (spec §5.6,
   owner ruling D3). Rendered at the end of chapter content (not a ConfirmDialog overlay — must not
   interrupt reading). The hosting reading page owns the gating: it fetches the prompt
   (IRecommendationReadService.GetHelpfulPromptAsync — non-null only when the reader's Read It Later
   was set from this recommendation's card or its direct link, the rec is still visible, its
   recommender is named, and no success is recorded) at the Ch.1 ≥90% moment.
   The recommendation itself renders as a read-only reminder card: the save may have been long ago.
   Exactly two controls — Yes (thumbs up) and X. There is no "No thanks": X is the decline. Either
   answer consumes the attribution, so the prompt never comes back (the host calls RecordSuccessAsync
   or DismissHelpfulPromptAsync). Self-contained: injects no service. *@

@if (!_answered)
{
    <div class="mt-6 rounded-xl border border-(--color-rec) bg-(--color-surface) p-4 shadow-subtle"
         role="region" aria-label="Recommendation feedback">
        <div class="mb-3 flex items-start gap-3">
            <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0" aria-hidden="true" fill="var(--color-rec)">
                <path d="@RecommendationIcons.RecommendationIconPath" />
            </svg>
            <p class="flex-1 min-w-0 text-sm text-(--color-text)">
                This recommendation brought you to this story. Did it help you find something you like?
            </p>
            <button type="button"
                    class="shrink-0 text-(--color-text-muted) hover:text-(--color-text)"
                    aria-label="Dismiss — don't ask about this recommendation again"
                    @onclick="HandleDismiss">
                <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>

        @* The reminder: the recommendation as it reads on the story page, with no actions wired. *@
        <div class="mb-3 min-w-0 break-words">
            <RecommendationCard Rec="@Recommendation" />
        </div>

        <button type="button"
                class="flex items-center gap-2 rounded-md bg-(--color-mission) px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-(--color-mission-hover)"
                aria-label="Yes, this recommendation helped me find this story"
                @onclick="HandleHelpful">
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" fill="currentColor">
                <path d="@RecommendationIcons.HelpfulIconPath" />
            </svg>
            Yes, it helped
        </button>
    </div>
}

@code {
    /// <summary>
    /// The recommendation the reader's Read It Later came from — shown in full as the reminder.
    /// </summary>
    [Parameter, EditorRequired] public RecommendationDto Recommendation { get; set; } = null!;

    /// <summary>Raised by Yes (thumbs up): the host records the success.</summary>
    [Parameter] public EventCallback OnHelpful { get; set; }

    /// <summary>Raised by X — the decline: the host deletes the attribution.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool _answered;

    private async Task HandleHelpful()
    {
        _answered = true;
        await OnHelpful.InvokeAsync();
    }

    private async Task HandleDismiss()
    {
        _answered = true;
        await OnDismiss.InvokeAsync();
    }
}
