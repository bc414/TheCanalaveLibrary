@namespace TheCanalaveLibrary.SharedUI
@using TheCanalaveLibrary.Core
@using Microsoft.Extensions.Logging
@inject IUserStoryInteractionWriteService Interactions
@inject NavigationManager Nav
@inject ILogger<ReadItLaterRecommendationCard> Logger

@* Coordination composite — a read-only RecommendationCard plus its two Feature 30 reader entry points
   (owner ruling D3), for the discovery hosts that show recommendations beside story cards (Explore,
   Deep Dive, Community Spotlight). It owns the one write those hosts share — Read It Later from the
   card, which saves the story AND records this recommendation as how it was saved — so the three hosts
   don't each re-implement the login nudge, the call and the error slot. (RecommendationSection, which
   already owns a full error/translate surface, wires the card directly.)
   After a successful save it raises OnSaved with the story id: the host must refresh its interaction
   state for that story and pass it to the StoryCard's panel, or the panel's next flush writes the bit
   back to false (the panel-clobber closure, WU-InertFeatures).
   The saved state is the HOST's (IsReadItLaterSaved), never latched here: the panel beside the card
   can clear the same bit, and a latched "saved" would leave the button disabled over a story that is
   no longer saved — blocking D3's "a re-RIL after a clear starts a new one" (review fixes). Holds a
   per-item error slot, so a host that swaps the Rec under one instance keys it on the rec id
   (layer3.5-structure.md §"@key"). *@

<RecommendationCard Rec="@Rec"
                    OnReadItLater="HandleReadItLaterAsync"
                    IsReadItLaterSaved="@IsReadItLaterSaved"
                    ShowReadNow="true" />
@if (_error is not null)
{
    <div class="mt-2"><ErrorAlert Message="@_error" ShowSignIn="@_errorIsSessionExpired" /></div>
}

@code {
    [Parameter, EditorRequired] public RecommendationDto Rec { get; set; } = null!;

    /// <summary>Null = anonymous viewer: Read It Later becomes a login nudge.</summary>
    [Parameter] public int? CurrentUserId { get; set; }

    /// <summary>
    /// Whether the viewer has the recommended story on Read It Later — the host's current copy of the
    /// bit (refreshed after <see cref="OnSaved"/> and whenever the story's interaction panel saves).
    /// </summary>
    [Parameter] public bool IsReadItLaterSaved { get; set; }

    /// <summary>
    /// Raised with the story id after a successful save, inside this component's error handling. The
    /// host re-reads that story's state; it is what turns the button to "Saved for later".
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<int> OnSaved { get; set; }

    private string? _error;
    private bool _errorIsSessionExpired;

    private async Task HandleReadItLaterAsync(int recommendationId)
    {
        if (CurrentUserId is null)
        {
            // Identity pages are server-rendered — a full load, returning here afterwards.
            Nav.NavigateTo(
                $"/Account/Login?ReturnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}",
                forceLoad: true);
            return;
        }

        _error = null;
        _errorIsSessionExpired = false;
        try
        {
            await Interactions.SetReadItLaterFromRecommendationAsync(recommendationId);
            if (OnSaved.HasDelegate)
                await OnSaved.InvokeAsync(Rec.StoryId);
        }
        catch (Exception ex)
        {
            // Exception-message discipline (error-handling.md): user-facing types translate without a
            // log; anything unexpected is logged before the generic message.
            if (!ExceptionPresenter.IsUserFacing(ex))
                Logger.LogError(ex, "Read It Later from recommendation {RecommendationId} failed unexpectedly", recommendationId);
            _error = ExceptionPresenter.GetUserMessage(ex);
            _errorIsSessionExpired = ex is SessionExpiredException;
        }
    }
}
