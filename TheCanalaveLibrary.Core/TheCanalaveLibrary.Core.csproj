<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.11" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
      <!-- Security pin for a transitive. The legacy Microsoft.AspNetCore.Identity 2.3.x above pulls
           System.Security.Cryptography.Xml in through DataProtection 2.3.0, and this pin lifts it
           to a patched servicing release (>= 10.0.10 clears GHSA-23rf/-8q5v/-cvvh/-g8r8/-mmjf,
           WU-DependencyCVEs 2026-10-12). It is the only pin: SharedUI, Client, SeedTool and the
           test projects inherit it through their reference to Core. The Server does not: .NET 10
           prunes the package there in favour of the ASP.NET Core shared framework's copy, so the
           deployed Server is patched only by the host runtime (>= 10.0.10; security.md Phase-7
           register). -->
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>

</Project>
